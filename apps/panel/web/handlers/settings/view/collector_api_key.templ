package view

import (
	"fmt"
	"strconv"

	"tracer/apps/panel/web/templates"
)

// collectorInstallCmdTmpl returns the install command with a placeholder
// for the API key that gets replaced at copy time.
func collectorInstallCmdTmpl(name, host string) string {
	return fmt.Sprintf(`curl -fsSL %s/panel/collectors/%s/install-script -H "X-API-Key: <API_KEY>" | sudo bash`, host, name)
}

// CollectorAPIKeyDetailProps holds data for the collector API key detail page.
type CollectorAPIKeyDetailProps struct {
	Title         string
	KeyID         int64
	KeyName       string
	CreatedAt     int64
	LastUsed      int64
	LastUsedValid bool
	CanReveal     bool
	Host          string
}

// CollectorAPIKeyDetail renders the collector API key detail page.
templ CollectorAPIKeyDetail(props CollectorAPIKeyDetailProps) {
	@templates.Layout("Collector API Key", templates.NavData{Since: "24h"}) {
		<div class="max-w-5xl mx-auto p-6">
			<div class="mb-6">
				@templates.BackwardAnchor("/settings", "text-sm text-fg-secondary hover:text-fg transition-colors") {
					Back to Settings
				}
			</div>

			<div class="mb-6">
				<h2 class="text-xl font-medium">Collector API Key</h2>
			</div>

			<div class="mb-8">
				<div class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 text-sm">
					<span class="text-fg-secondary">Name:</span>
					<span>{ props.KeyName }</span>

					<span class="text-fg-secondary">Key Suffix:</span>
					@APIKeyValue(APIKeyValueProps{
						RevealURL: "/settings/admin/collector-api-keys/" + strconv.FormatInt(props.KeyID, 10) + "/reveal",
						TargetID:  "collector-api-key-value",
						CanReveal: props.CanReveal,
					})

					<span class="text-fg-secondary">Created:</span>
					<span>{ formatTimestamp(props.CreatedAt) }</span>

					<span class="text-fg-secondary">Last Used:</span>
					<span>
						if props.LastUsedValid {
							{ formatTimestamp(props.LastUsed) }
						} else {
							Never
						}
					</span>
				</div>
			</div>

			<div class="mb-8">
				<h3 class="text-lg font-medium mb-3">Install</h3>
				<p class="text-sm text-fg-secondary mb-3">Reveal the key, then copy and paste this command on the collector host:</p>
				<div class="relative">
					<pre id="collector-onboarding" class="bg-bg-secondary p-4 pr-20 overflow-x-auto text-sm"
						data-install-tmpl={ collectorInstallCmdTmpl(props.KeyName, props.Host) }><code>{ collectorInstallCmdTmpl(props.KeyName, props.Host) }</code></pre>
					<button type="button"
							onclick="copyCollectorOnboarding(this)"
							class="absolute top-2 right-2 text-xs px-2 py-1 bg-bg text-fg-secondary hover:text-fg transition-colors"
							title="Copy command">Copy</button>
				</div>
			</div>
			<script>
				function copyCollectorOnboarding(btn) {
					var keyEl = document.querySelector('#collector-api-key-value code');
					var key = keyEl ? keyEl.textContent.trim() : '';
					if (!key) {
						alert('Reveal the API key first.');
						return;
					}
					var cmd = document.getElementById('collector-onboarding').getAttribute('data-install-tmpl').replace('<API_KEY>', key);
					navigator.clipboard.writeText(cmd).then(function() {
						btn.textContent = 'Copied!';
						setTimeout(function() { btn.textContent = 'Copy'; }, 1500);
					});
				}
			</script>

			<div>
				<button hx-delete={ "/settings/admin/collector-api-keys/" + strconv.FormatInt(props.KeyID, 10) }
						hx-confirm={ "Delete collector API key " + props.KeyName + "?" }
						hx-target="body"
						hx-swap="outerHTML"
						class="text-sm text-fg-secondary hover:text-red-500 underline transition-colors">
					Delete collector API key
				</button>
			</div>
		</div>
	}
}
