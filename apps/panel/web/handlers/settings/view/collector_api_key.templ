package view

import (
	"tracer/apps/panel/web/templates"
)

// CollectorAPIKeyDetailProps holds data for the collector API key detail page.
type CollectorAPIKeyDetailProps struct {
	Title         string
	KeyName       string
	KeySuffix     string
	CreatedAt     int64
	LastUsed      int64
	LastUsedValid bool
	CanReveal     bool
	ReadOnly      bool
}

// CollectorAPIKeyKeyRowProps holds data for the key value fragment rendered by
// the reveal endpoint. Revealed controls whether the plaintext is shown;
// RevealError, when set, is displayed instead of a reveal button; ReadOnly
// hides the reveal button entirely (the reveal POST is blocked by the
// read-only middleware).
type CollectorAPIKeyKeyRowProps struct {
	KeyName      string
	KeySuffix    string
	CanReveal    bool
	Revealed     bool
	ReadOnly     bool
	PlaintextKey string
	RevealError  string
}

// CollectorAPIKeyDetail renders the collector API key detail page.
templ CollectorAPIKeyDetail(props CollectorAPIKeyDetailProps) {
	@templates.Layout("Collector API Key", templates.NavData{Since: "24h"}) {
		<div class="max-w-5xl mx-auto p-6">
			<div class="mb-6">
				<a href="/settings" class="text-sm text-fg-secondary hover:text-fg transition-colors">&larr; Back to Settings</a>
			</div>

			<div class="mb-6">
				<h2 class="text-xl font-medium">Collector API Key</h2>
			</div>

			<div class="mb-8">
				<div class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 text-sm">
					<span class="text-fg-secondary">Name:</span>
					<span>{ props.KeyName }</span>

					<span class="text-fg-secondary">Key Suffix:</span>
					@CollectorAPIKeyKeyRow(CollectorAPIKeyKeyRowProps{
						KeyName:   props.KeyName,
						KeySuffix: props.KeySuffix,
						CanReveal: props.CanReveal,
						ReadOnly:  props.ReadOnly,
					})

					<span class="text-fg-secondary">Created:</span>
					<span>{ formatTimestamp(props.CreatedAt) }</span>

					<span class="text-fg-secondary">Last Used:</span>
					<span>
						if props.LastUsedValid {
							{ formatTimestamp(props.LastUsed) }
						} else {
							Never
						}
					</span>
				</div>
			</div>

			<div>
				<button hx-delete={ "/settings/admin/collector-api-keys/" + props.KeyName }
						hx-confirm={ "Delete collector API key " + props.KeyName + "?" }
						hx-target="body"
						hx-swap="outerHTML"
						class="text-sm text-fg-secondary hover:text-red-500 underline transition-colors">
					Delete collector API key
				</button>
			</div>
		</div>
	}
}

// CollectorAPIKeyKeyRow renders the key value on the collector API key detail
// page. The reveal endpoint returns this fragment standalone so htmx can swap
// it in place; the reveal/hide buttons POST to the reveal endpoint, which is
// rejected by the read-only middleware so keys can never be exposed in
// read-only mode.
templ CollectorAPIKeyKeyRow(props CollectorAPIKeyKeyRowProps) {
		<span id="collector-api-key-value" class="flex items-center gap-3">
			if props.Revealed && props.PlaintextKey != "" {
				<code class="text-sm font-mono break-all">{ props.PlaintextKey }</code>
				<button type="button"
						hx-post={ "/settings/admin/collector-api-keys/" + props.KeyName + "/reveal" }
						hx-vals='{"revealed":"0"}'
						hx-target="#collector-api-key-value"
						hx-swap="outerHTML"
						class="icon-btn text-fg-secondary transition-colors"
						title="Hide API key"
						aria-label="Hide API key">
					<img src="/static/img/eye-off.svg" alt="Hide API key" width="20" height="20"/>
				</button>
			} else {
				<code class="text-sm font-mono">****{ props.KeySuffix }</code>
				if props.RevealError != "" {
					<span class="text-xs text-red-400">{ props.RevealError }</span>
				} else if props.ReadOnly {
					<span class="text-xs text-fg-secondary/60" title="Read-only mode hides API keys">Read-only</span>
				} else if !props.CanReveal {
					<span class="text-xs text-fg-secondary/60" title="Key was created before reveal support and cannot be shown again">Not revealable</span>
				} else {
					<button type="button"
							hx-post={ "/settings/admin/collector-api-keys/" + props.KeyName + "/reveal" }
							hx-vals='{"revealed":"1"}'
							hx-target="#collector-api-key-value"
							hx-swap="outerHTML"
							class="icon-btn text-fg-secondary transition-colors"
							title="Show API key"
							aria-label="Show API key">
						<img src="/static/img/eye.svg" alt="Show API key" width="20" height="20"/>
					</button>
				}
			}
		</span>
}
