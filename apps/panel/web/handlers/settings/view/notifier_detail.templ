package view

import (
	"strconv"
	"tracer/apps/panel/web/templates"
)

// NotifierDetailProps holds data for the notifier detail page.
type NotifierDetailProps struct {
	Title        string
	NotifierID   int64
	NotifierName string
	NotifierType string
	Enabled      int64
	Config       string
	Apps         []NotifierAppView
}

// NotifierDetail renders the notifier detail page.
templ NotifierDetail(props NotifierDetailProps) {
	@templates.Layout("Notifier", templates.NavData{Since: "24h"}) {
		<div class="max-w-5xl mx-auto p-6">
			<div class="mb-6">
				<a href="/settings" class="text-sm text-fg-secondary hover:text-fg transition-colors">&larr; Back to Settings</a>
			</div>

			<div class="mb-6 flex items-center justify-between gap-4">
				<h2 class="text-xl font-medium">Notifier</h2>
				<button hx-delete={ "/settings/notifiers/" + strconv.FormatInt(props.NotifierID, 10) }
						hx-confirm={ "Delete notifier " + props.NotifierName + "?" }
						hx-target="body" hx-swap="outerHTML"
						class="text-sm text-fg-secondary hover:text-red-500 underline transition-colors">Delete</button>
			</div>

			<div class="mb-8">
				<div class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 text-sm">
					<span class="text-fg-secondary">Name:</span>
					<span>{ props.NotifierName }</span>

					<span class="text-fg-secondary">Type:</span>
					<span>{ props.NotifierType }</span>

					<span class="text-fg-secondary">Status:</span>
					<span class="flex items-center gap-3">
						if props.Enabled == 1 {
							Enabled
						} else {
							Disabled
						}
						<button hx-put={ "/settings/notifiers/" + strconv.FormatInt(props.NotifierID, 10) + "/toggle" }
								hx-target="body" hx-swap="outerHTML"
								class="text-sm text-fg-secondary hover:text-fg transition-colors">
							if props.Enabled == 1 {
								Disable
							} else {
								Enable
							}
						</button>
					</span>
				</div>
			</div>

			<div class="mb-8">
				<h3 class="text-sm text-fg-secondary mb-3">Config</h3>
				@templates.JSONViewerFull(props.Config, true)
			</div>

			<div class="mb-6">
				<h3 class="text-xl font-medium mb-4">Subscriptions</h3>
				@NotifierSubscriptionsForm(props)
			</div>
		</div>
		@templates.MarkdownCheckboxScript()
	}
}

// NotifierSubscriptionsForm renders the subscriptions form for a notifier.
templ NotifierSubscriptionsForm(props NotifierDetailProps) {
	<form hx-put={ "/settings/notifiers/" + strconv.FormatInt(props.NotifierID, 10) + "/subscriptions" }
		  hx-target="closest .max-w-5xl"
		  hx-swap="innerHTML"
		  class="space-y-2 max-w-md">
		if len(props.Apps) == 0 {
			<p class="text-sm text-fg-secondary/60">No apps available.</p>
		} else {
			for _, app := range props.Apps {
				<label class="flex items-center gap-2 cursor-pointer hover:bg-bg-secondary/50 p-2 transition-colors">
					<input type="checkbox" name="apps" value={ app.CollectorName + ":" + app.AppName }
						   checked={ app.Enabled }
						   class="accent-accent"/>
					<span class="text-sm">{ app.CollectorName }/<span class="font-medium">{ app.AppName }</span></span>
				</label>
			}
			<button type="submit" class="block text-sm text-accent hover:underline mt-4">Save</button>
		}
	</form>
}
