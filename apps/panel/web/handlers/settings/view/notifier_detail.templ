package view

import (
	"strconv"

	"tracer/apps/panel/internal/domain"
	"tracer/apps/panel/internal/services/notify"
	"tracer/apps/panel/web/templates"
)

// NotifierDetailProps holds data for the notifier detail page.
type NotifierDetailProps struct {
	Setup    notify.Setup
	Apps     []domain.ScopeEntry
	ReadOnly bool
}

// NotifierDetail renders the notifier detail page. In read-only mode the
// delete, toggle, and subscription form controls are hidden.
templ NotifierDetail(props NotifierDetailProps) {
	@templates.Layout("Notifier", templates.NavData{Since: "24h"}) {
		<div class="max-w-5xl mx-auto p-6">
			<div class="mb-6">
				<a href="/settings" class="text-sm text-accent hover:underline transition-colors">&larr; Back to Settings</a>
			</div>

			<div class="mb-6 flex items-center justify-between gap-4">
				<h2 class="text-xl font-medium">Notifier</h2>
				if !props.ReadOnly {
					<button hx-delete={ "/settings/notifiers/" + strconv.FormatInt(props.Setup.ID, 10) }
							hx-confirm={ "Delete notifier " + props.Setup.Name + "?" }
							hx-target="body" hx-swap="outerHTML"
							class="text-sm text-fg-secondary hover:text-red-500 underline transition-colors">Delete</button>
				}
			</div>

			<div class="mb-8">
				<div class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 text-sm">
					<span class="text-fg-secondary">Name:</span>
					<span>{ props.Setup.Name }</span>

					<span class="text-fg-secondary">Type:</span>
					<span>{ props.Setup.Type }</span>

					<span class="text-fg-secondary">Status:</span>
					<span class="flex items-center gap-3">
						if props.Setup.Enabled == 1 {
							Enabled
						} else {
							Disabled
						}
						if !props.ReadOnly {
							<button hx-put={ "/settings/notifiers/" + strconv.FormatInt(props.Setup.ID, 10) + "/toggle" }
									hx-target="body" hx-swap="outerHTML"
									class="text-sm text-fg-secondary hover:text-fg transition-colors">
								if props.Setup.Enabled == 1 {
									Disable
								} else {
									Enable
								}
							</button>
						}
					</span>
				</div>
			</div>

			<div class="mb-8">
				<h3 class="text-sm text-fg-secondary mb-3">Config</h3>
				@templates.JSONViewerFull(props.Setup.Config, true)
			</div>

			if !props.ReadOnly {
				<div class="mb-6">
					<h3 class="text-xl font-medium mb-4">Subscriptions</h3>
					<p class="text-base text-fg-secondary mb-6">Select which applications this notifier receives alerts for:</p>
					@ScopeTree(
						"put",
						"/settings/notifiers/" + strconv.FormatInt(props.Setup.ID, 10) + "/subscriptions",
						props.Apps,
					)
				</div>
			}
		</div>
	}
}
