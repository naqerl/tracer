package view

import (
	"strconv"

	"tracer/apps/panel/web/templates"
)

// UserAPIKeyDetailProps holds data for the user API key detail page.
type UserAPIKeyDetailProps struct {
	Title         string
	KeyID         int64
	KeyName       string
	CreatedAt     int64
	LastUsed      int64
	LastUsedValid bool
	CanReveal     bool
	ReadOnly      bool
	Host          string
}

// UserAPIKeyDetail renders the user API key detail page.
templ UserAPIKeyDetail(props UserAPIKeyDetailProps) {
	@templates.Layout(props.Title, templates.NavData{Since: "24h"}) {
		<div class="max-w-5xl mx-auto p-6">
			<div class="mb-6">
				<a href="/settings" class="text-sm text-fg-secondary hover:text-fg transition-colors">&larr; Back to Settings</a>
			</div>

			<div class="mb-6">
				<h2 class="text-xl font-medium">API Key</h2>
			</div>

			<div class="mb-8">
				<div class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 text-sm">
					<span class="text-fg-secondary">Name:</span>
					<span>{ props.KeyName }</span>

					<span class="text-fg-secondary">Key:</span>
					@APIKeyValue(APIKeyValueProps{
						RevealURL: "/settings/api-keys/" + strconv.FormatInt(props.KeyID, 10) + "/reveal",
						TargetID:  "user-api-key-value",
						CanReveal: props.CanReveal,
						ReadOnly:  props.ReadOnly,
					})

					<span class="text-fg-secondary">Created:</span>
					<span>{ formatTimestamp(props.CreatedAt) }</span>

					<span class="text-fg-secondary">Last Used:</span>
					<span>
						if props.LastUsedValid {
							{ formatTimestamp(props.LastUsed) }
						} else {
							Never
						}
					</span>
				</div>
			</div>

			<div class="mb-8">
				<h3 class="text-lg font-medium mb-3">Using this key</h3>
				<p class="text-sm text-fg-secondary mb-3">
					Point your agent at { props.Host } with this key to start investigating logs. Set the <code class="text-green-400">Accept</code> header to <code class="text-green-400">text/markdown</code> and the request will reach the <code class="text-accent">/panel</code> route:
				</p>
				<pre class="bg-bg p-4 overflow-x-auto text-sm"><code>curl -H "X-API-Key: YOUR_KEY" -H "Accept: text/markdown" \
  "{ props.Host }/panel"</code></pre>
			</div>

			<div>
				<button hx-delete={ "/settings/api-keys/" + strconv.FormatInt(props.KeyID, 10) }
						hx-confirm={ "Delete API key " + props.KeyName + "?" }
						hx-target="body"
						hx-swap="outerHTML"
						class="text-sm text-fg-secondary hover:text-red-500 underline transition-colors">
					Delete API key
				</button>
			</div>
		</div>
	}
}
