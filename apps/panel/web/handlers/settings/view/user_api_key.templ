package view

import (
	"fmt"
	"strconv"

	"tracer/apps/panel/web/templates"
)

// agentPrompt returns the copyable instruction block that tells an agent how
// to start working with Tracer using this API key.
func agentPrompt(host string) string {
	return fmt.Sprintf(`Use your configured secret storage to get the Tracer API key, or ask me to provide it.
Use simple HTTP requests to navigate Tracer.
Set the header "X-API-Key: YOUR_KEY" with every request.
Start from this request to get further details and insights:
curl -H "X-API-Key: YOUR_KEY" -H "Accept: text/markdown" %s/panel`, host)
}

// UserAPIKeyDetailProps holds data for the user API key detail page.
type UserAPIKeyDetailProps struct {
	Title         string
	KeyID         int64
	KeyName       string
	CreatedAt     int64
	LastUsed      int64
	LastUsedValid bool
	CanReveal     bool
	ReadOnly      bool
	Host          string
}

// UserAPIKeyDetail renders the user API key detail page.
templ UserAPIKeyDetail(props UserAPIKeyDetailProps) {
	@templates.Layout(props.Title, templates.NavData{Since: "24h"}) {
		<div class="max-w-5xl mx-auto p-6">
			<div class="mb-6">
				@templates.BackwardAnchor("/settings", "text-sm text-fg-secondary hover:text-fg transition-colors") {
					Back to Settings
				}
			</div>

			<div class="mb-6">
				<h2 class="text-xl font-medium">API Key</h2>
			</div>

			<div class="mb-8">
				<div class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 text-sm">
					<span class="text-fg-secondary">Name:</span>
					<span>{ props.KeyName }</span>

					<span class="text-fg-secondary">Key:</span>
					@APIKeyValue(APIKeyValueProps{
						RevealURL: "/settings/api-keys/" + strconv.FormatInt(props.KeyID, 10) + "/reveal",
						TargetID:  "user-api-key-value",
						CanReveal: props.CanReveal,
						ReadOnly:  props.ReadOnly,
					})

					<span class="text-fg-secondary">Created:</span>
					<span>{ formatTimestamp(props.CreatedAt) }</span>

					<span class="text-fg-secondary">Last Used:</span>
					<span>
						if props.LastUsedValid {
							{ formatTimestamp(props.LastUsed) }
						} else {
							Never
						}
					</span>
				</div>
			</div>

			<div class="mb-8">
				<h3 class="text-lg font-medium mb-3">Prompt for your agent</h3>
				<div class="relative">
					<pre id="agent-prompt" class="bg-bg-secondary p-4 pr-20 overflow-x-auto text-sm"><code>{ agentPrompt(props.Host) }</code></pre>
					<button type="button"
							onclick="copyAgentPrompt(this)"
							class="absolute top-2 right-2 text-xs px-2 py-1 rounded bg-bg text-fg-secondary hover:text-fg transition-colors"
							title="Copy prompt">Copy</button>
				</div>
			</div>
			<script>
				function copyAgentPrompt(btn) {
					var text = document.getElementById('agent-prompt').textContent;
					navigator.clipboard.writeText(text).then(function() {
						btn.textContent = 'Copied!';
						setTimeout(function() { btn.textContent = 'Copy'; }, 1500);
					});
				}
			</script>

			<div>
				<button hx-delete={ "/settings/api-keys/" + strconv.FormatInt(props.KeyID, 10) }
						hx-confirm={ "Delete API key " + props.KeyName + "?" }
						hx-target="body"
						hx-swap="outerHTML"
						class="text-sm text-fg-secondary hover:text-red-500 underline transition-colors">
					Delete API key
				</button>
			</div>
		</div>
	}
}
