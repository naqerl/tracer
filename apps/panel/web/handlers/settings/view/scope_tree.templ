package view

import (
	"fmt"
	"sort"

	"tracer/apps/panel/internal/domain"
	"tracer/apps/panel/web/templates"
)

// ScopeTree renders a full permission form: a hierarchical markdown-style
// tree grouped by collector, an empty state when there are no entries, and
// Save Changes / Cancel actions. The form submits to action with the given
// htmx method (e.g. "put").
templ ScopeTree(method string, action string, entries []domain.ScopeEntry) {
	<form { scopeTreeFormAttrs(method, action)... }
		  hx-target="closest .max-w-5xl"
		  hx-swap="innerHTML"
		  class="space-y-2">
		if len(entries) == 0 {
			<div class="text-center text-fg-secondary py-8">
				<p>No applications available yet.</p>
				<p class="text-sm mt-2">Start a collector to begin receiving logs and create applications.</p>
			</div>
		} else {
			{{ allCollectors, hasAllCollectors, groupedEntries := splitAllCollectorsEntry(entries) }}
			if hasAllCollectors {
				<div data-scope-wildcard="1">
					@templates.MarkdownCheckbox(
						scopeTreeWildcardID("*:*"),
						"apps",
						"all collectors, all apps",
						"*:*",
						allCollectors.Granted,
						0,
					)
				</div>
			}
			{{ order, grouped := groupScopeEntries(groupedEntries) }}
			for ci, collector := range order {
				{{ apps := grouped[collector] }}
				<div class="py-2" data-scope-collector={ collector }>
					<button
						type="button"
						id={ scopeTreeCollectorID(collector, ci) + "_toggle" }
						class={ "text-base transition-colors font-mono " + tern(allGranted(apps), "text-fg", "text-fg-secondary hover:text-fg") }
						data-action="toggle-scope-collector"
						data-label={ collector }>
						{ tern(allGranted(apps), "[x] ", "[ ] ") + collector }
					</button>
					<div class="space-y-1 mt-2">
						for ai, app := range apps {
							if app.App == "*" {
								<div data-scope-wildcard="1">
									@templates.MarkdownCheckbox(
										scopeTreeWildcardID(app.Collector + ":*", ci),
										"apps",
										"all apps",
										app.Collector + ":*",
										app.Granted,
										1,
									)
								</div>
							} else {
								@templates.MarkdownCheckbox(
									scopeTreeAppID(app.Collector, ci, app.App, ai),
									"apps",
									app.App,
									app.Collector + ":" + app.App,
									app.Granted,
									1,
								)
							}
						}
					</div>
				</div>
			}
			<div class="flex gap-3 mt-6">
				<button type="submit" class="text-sm text-fg border border-fg px-4 py-2 hover:bg-fg hover:text-bg transition-colors">Save Changes</button>
				<a href="/settings" class="text-sm text-fg-secondary border border-fg-secondary px-4 py-2 hover:bg-fg-secondary hover:text-bg transition-colors">Cancel</a>
			</div>
		}
	</form>
	@templates.MarkdownCheckboxScript()
	<script src="/static/scope-tree.js"></script>
}

// scopeTreeFormAttrs returns the hx-{method} attribute for the form so the
// submit method can be selected per call site.
func scopeTreeFormAttrs(method, action string) templ.Attributes {
	return templ.Attributes{
		"hx-" + method: action,
	}
}

// splitAllCollectorsEntry removes all-collectors wildcards so one can render
// above the collector groups.
func splitAllCollectorsEntry(entries []domain.ScopeEntry) (domain.ScopeEntry, bool, []domain.ScopeEntry) {
	var allCollectors domain.ScopeEntry
	found := false
	remaining := make([]domain.ScopeEntry, 0, len(entries))
	for _, entry := range entries {
		if entry.Collector != "*" || entry.App != "*" {
			remaining = append(remaining, entry)
			continue
		}
		if !found {
			allCollectors = entry
			found = true
		}
	}
	return allCollectors, found, remaining
}

// groupScopeEntries groups a flat list of collector/app entries by collector,
// sorting collectors and the apps within each collector alphabetically.
func groupScopeEntries(entries []domain.ScopeEntry) ([]string, map[string][]domain.ScopeEntry) {
	byCollector := make(map[string][]domain.ScopeEntry)
	for _, e := range entries {
		byCollector[e.Collector] = append(byCollector[e.Collector], e)
	}
	order := make([]string, 0, len(byCollector))
	for collector := range byCollector {
		order = append(order, collector)
	}
	sort.Strings(order)
	for collector := range byCollector {
		sort.Slice(byCollector[collector], func(i, j int) bool {
			return byCollector[collector][i].App < byCollector[collector][j].App
		})
	}
	return order, byCollector
}

// allGranted reports whether every real app in the group is granted.
func allGranted(apps []domain.ScopeEntry) bool {
	granted := 0
	for _, a := range apps {
		if a.App == "*" {
			continue
		}
		if !a.Granted {
			return false
		}
		granted++
	}
	return granted > 0
}

// scopeTreeWildcardID returns the id prefix for a wildcard checkbox; scope is
// the submitted value (e.g. "*:*" or "prod:*") and rowIndex keeps rows with
// colliding sanitized names distinct.
func scopeTreeWildcardID(scope string, rowIndex ...int) string {
	id := "scope_wildcard_" + templates.SanitizeID(scope)
	if len(rowIndex) == 0 {
		return id
	}
	return fmt.Sprintf("%s_%d", id, rowIndex[0])
}

// scopeTreeCollectorID returns the button id for a collector row; the index
// keeps rows distinct even when collector names sanitize to the same id.
func scopeTreeCollectorID(collector string, idx int) string {
	return fmt.Sprintf("scope_%s_%d", templates.SanitizeID(collector), idx)
}

// scopeTreeAppID returns the id prefix for an app row (used with _value/_toggle);
// the collector and app indices keep rows distinct even when names sanitize to
// the same id.
func scopeTreeAppID(collector string, collectorIdx int, app string, appIdx int) string {
	return fmt.Sprintf("scope_%s_%d_%s_%d", templates.SanitizeID(collector), collectorIdx, templates.SanitizeID(app), appIdx)
}
