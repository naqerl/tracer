package view

import (
	"strconv"
	"tracer/apps/panel/web/templates"
)

// NotifierSubscriptionsProps holds data for the notifier subscriptions page.
type NotifierSubscriptionsProps struct {
	Title         string
	NotifierID    int64
	NotifierName  string
	Apps          []NotifierAppView
}

type NotifierAppView struct {
	CollectorName string
	AppName       string
	Enabled       bool
}

// NotifierSubscriptions renders the notifier subscriptions page.
templ NotifierSubscriptions(props NotifierSubscriptionsProps) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			@templates.Head()
			<title>{ props.Title } - Tracer</title>
		</head>
		<body>
			@templates.Navbar(templates.NavData{Since: "24h"})
			<div class="max-w-5xl mx-auto p-6">
				<div class="mb-6">
					<a href="/settings" class="text-sm text-fg-secondary hover:text-fg transition-colors">&larr; Back to settings</a>
				</div>
				<h2 class="text-xl font-medium mb-2">Subscriptions</h2>
				<p class="text-base text-fg-secondary mb-6">{ props.NotifierName }</p>
				<form hx-put={ "/settings/notifiers/" + strconv.FormatInt(props.NotifierID, 10) + "/subscriptions" }
					  hx-target="closest .max-w-5xl"
					  hx-swap="innerHTML"
					  class="space-y-2 max-w-md">
					if len(props.Apps) == 0 {
						<p class="text-sm text-fg-secondary/60">No apps available.</p>
					} else {
						for _, app := range props.Apps {
							<label class="flex items-center gap-2 cursor-pointer hover:bg-bg-secondary/50 p-2 transition-colors">
								<input type="checkbox" name="apps" value={ app.CollectorName + ":" + app.AppName }
									   checked={ app.Enabled }
									   class="accent-accent"/>
								<span class="text-sm">{ app.CollectorName }/<span class="font-medium">{ app.AppName }</span></span>
							</label>
						}
						<button type="submit" class="block text-sm text-accent hover:underline mt-4">Save</button>
					}
				</form>
			</div>
		</body>
	</html>
}
