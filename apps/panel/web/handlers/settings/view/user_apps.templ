package view

import (
	"strconv"

	"tracer/apps/panel/internal/domain"
	"tracer/apps/panel/web/templates"
)

// UserAppsProps holds data for the user detail page.
type UserAppsProps struct {
	UserID   int64
	UserName string
	Role     domain.Role
	Apps     []domain.ScopeEntry
}

// UserDetail renders the user detail page, mirroring the notifier detail page:
// a back link, a header with a delete button, an info grid, then the shared
// scope tree for app permissions. The page and notifier subscriptions share
// the same ScopeTree component so both permission surfaces behave identically.
templ UserDetail(props UserAppsProps) {
	@templates.Layout("User", templates.NavData{Since: "24h"}) {
		<div class="max-w-5xl mx-auto p-6">
			<div class="mb-6">
				@templates.BackwardAnchor("/settings", "text-sm text-accent hover:underline transition-colors") {
					Back to Settings
				}
			</div>

			<div class="mb-6 flex items-center justify-between gap-4">
				<h2 class="text-xl font-medium">User</h2>
				<button hx-delete={ "/settings/users/" + strconv.FormatInt(props.UserID, 10) }
						hx-confirm={ "Delete user " + props.UserName + "?" }
						hx-target="body" hx-swap="outerHTML"
						class="text-sm text-fg-secondary hover:text-red-500 underline transition-colors">Delete</button>
			</div>

			<div class="mb-8">
				<div class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 text-sm">
					<span class="text-fg-secondary">Username:</span>
					<span>{ props.UserName }</span>

					<span class="text-fg-secondary">Role:</span>
					<span>{ props.Role }</span>
				</div>
			</div>

			<div class="mb-6">
				<h3 class="text-xl font-medium mb-4">Apps</h3>
				<p class="text-base text-fg-secondary mb-6">Select which applications this user can access:</p>
				@ScopeTree(
					"put",
					"/settings/users/" + strconv.FormatInt(props.UserID, 10) + "/apps",
					props.Apps,
				)
			</div>
		</div>
	}
}
