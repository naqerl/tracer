package view

import (
	"fmt"
)

templ NewCollectorForm() {
	<div class="border border-bg-secondary/70 p-4 mb-4">
		<form hx-post="/panel/collectors" hx-target="#new-collector-container" hx-swap="innerHTML" class="space-y-3">
			<div>
				<label class="block text-sm text-fg-secondary mb-1">Collector name</label>
				<input type="text" name="name" required placeholder="e.g. web-01" class="w-full bg-transparent border-b border-fg/20 focus:border-fg/60 focus:outline-none px-2 py-2 text-base text-fg placeholder:text-fg-secondary/50"/>
			</div>
			<div class="flex gap-2">
				<button type="submit" class="text-sm text-fg border border-fg px-4 py-2 hover:bg-fg hover:text-bg transition-colors">Create</button>
				<button type="button" hx-on:click="window.location.reload()" class="text-sm text-fg-secondary border border-bg-secondary px-4 py-2 hover:text-fg transition-colors">Cancel</button>
			</div>
		</form>
	</div>
}

type AppSavedProps struct {
	Collector string
	AppName   string
}

templ AppSaved(p AppSavedProps) {
	<div class="border border-green-500/30 p-4 mb-4">
		<div class="text-green-400 font-medium mb-2">✓ App "{ p.AppName }" saved</div>
		<div class="text-sm text-fg-secondary mb-3">The configuration has been pushed to collector "{ p.Collector }".</div>
		<div class="flex gap-2">
			<a
				href={ "/panel/collectors/" + p.Collector }
				class="text-sm text-fg border border-fg px-4 py-2 hover:bg-fg hover:text-bg transition-colors inline-block"
			>
				Back to collector
			</a>
			<a
				href={ "/panel/collectors/" + p.Collector + "/apps/" + p.AppName }
				class="text-sm text-fg-secondary border border-bg-secondary px-4 py-2 hover:text-fg transition-colors inline-block"
			>
				View app
			</a>
		</div>
	</div>
}

type CollectorCreatedProps struct {
	Name string
	Key  string
	Host string
}

templ CollectorCreated(p CollectorCreatedProps) {
	<div class="border border-green-500/30 p-4 mb-4">
		<div class="text-green-400 font-medium mb-2">✓ Collector "{ p.Name }" created</div>
		<div class="text-sm text-fg-secondary mb-3">
			Run this command on the collector host to connect it:
		</div>
		<pre class="bg-bg p-3 font-mono text-xs text-fg overflow-x-auto mb-4 whitespace-pre-wrap">{ fmt.Sprintf(`curl -fsSL %s/panel/collectors/%s/install-script -H "X-API-Key: %s" | sudo bash`, p.Host, p.Name, p.Key) }</pre>
		<a
			href={ "/panel/collectors/" + p.Name }
			class="text-sm text-fg border border-fg px-4 py-2 hover:bg-fg hover:text-bg transition-colors inline-block"
		>
			Configure apps →
		</a>
	</div>
}
