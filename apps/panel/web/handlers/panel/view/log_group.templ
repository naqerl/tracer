package view

import (
	"strconv"
	"time"
	"tracer/apps/panel/web/templates"
)

// LogGroupProps holds data for the log group detail page.
type LogGroupProps struct {
	Title         string
	AppName       string
	CollectorName string
	Since         string
	SinceStart    int64
	SinceEnd      int64
	LogGroup      LogGroupData
}

type LogGroupData struct {
	ID          int64
	Message     string
	Level       string
	Count       int64
	CreatedAt   int64
	LastLogAt   int64
	Since       int64
	NewLogs     int64
	IssueNumber int64
	IssueURL    string
}

// LogGroup renders the log group detail page.
templ LogGroup(props LogGroupProps) {
	@templates.Layout(props.Title, templates.NavData{Since: props.Since}) {
		<div class="max-w-5xl mx-auto p-6">
			@LogGroupContent(props)
		</div>
	}
}

// LogGroupContent renders the log group content.
templ LogGroupContent(props LogGroupProps) {
	<!-- Breadcrumb with Delete -->
	<div class="mb-6 flex items-center justify-between gap-4">
		<a href={ "/panel/collectors/" + props.CollectorName + "/apps/" + props.AppName } class="text-sm text-fg-secondary hover:text-fg transition-colors">&larr; Back to app</a>
		<button hx-delete={ "/panel/collectors/" + props.CollectorName + "/apps/" + props.AppName + "/logs/groups/" + strconv.FormatInt(props.LogGroup.ID, 10) }
				hx-confirm={ "Delete log group '" + props.LogGroup.Message + "'?" }
				class="text-sm text-fg-secondary hover:text-red-500 underline transition-colors">Delete</button>
	</div>

	<!-- Group Header -->
	<div class="mb-6">
		@LogMessage(props.LogGroup.Message, props.LogGroup.Level)
		<div id="log-group-summary"
			 hx-get={ "/panel/collectors/" + props.CollectorName + "/apps/" + props.AppName + "/logs/groups/" + strconv.FormatInt(props.LogGroup.ID, 10) + "/summary" }
			 hx-include="#log-group-since"
			 hx-trigger="load, every 15s"
			 hx-swap="innerHTML">
			@LogGroupSummary(props.LogGroup)
		</div>
	</div>

	<!-- Log Entries Container (loaded via HTMX) -->
	<div id="log-entries-container" class="mt-6 space-y-3"
		 hx-get={ "/panel/collectors/" + props.CollectorName + "/apps/" + props.AppName + "/logs/groups/" + strconv.FormatInt(props.LogGroup.ID, 10) + "/entries?level=" + props.LogGroup.Level }
		 hx-trigger="load"
		 hx-swap="innerHTML"
		 hx-indicator="#log-entries-loading">
		<div class="text-center text-sm text-fg-secondary/60 py-12">
			@templates.Indicator("log-entries-loading", "Loading log entries...")
		</div>
	</div>
}

// levelDotClass returns the CSS class for a log level dot.
func levelDotClass(level string) string {
	switch level {
	case "error":
		return "bg-red-500"
	case "warn":
		return "bg-yellow-500"
	case "info":
		return "bg-blue-500"
	default:
		return "bg-fg-secondary"
	}
}

// LogMessage renders a log message with level indicator.
templ LogMessage(message string, level string) {
	<div class="mb-2">
		<span class={ "inline-block w-2 h-2 rounded-full mr-3 mt-2 " + levelDotClass(level) }></span>
		<span class="text-xl font-medium break-all">{ message }</span>
	</div>
}

// LogGroupSummary renders the log group metadata row (count, first, latest)
// with a "+N" badge for rows created since the last poll.
templ LogGroupSummary(group LogGroupData) {
	<input type="hidden" name="since" id="log-group-since" value={ strconv.FormatInt(group.Since, 10) } />
	<div class="flex flex-wrap gap-4 text-sm text-fg-secondary">
		<span>Level: <span class="text-fg uppercase">{ group.Level }</span></span>
		<span>Count: <span class="text-fg">{ strconv.FormatInt(group.Count, 10) }</span></span>
		<span>First: <span class="text-fg">{ time.Unix(group.CreatedAt, 0).Format("2006-01-02 15:04:05") }</span></span>
		<span>Latest: <span class="text-fg">{ time.Unix(group.LastLogAt, 0).Format("2006-01-02 15:04:05") }</span></span>
		if group.NewLogs > 0 {
			<span class="cursor-help font-medium text-yellow-400"
				  title="There are new log records, refresh the page to see them">+{ strconv.FormatInt(group.NewLogs, 10) }</span>
		}
		if group.IssueURL != "" {
			<a href={ group.IssueURL } target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">issue #{ strconv.FormatInt(group.IssueNumber, 10) }</a>
		}
	</div>
}
