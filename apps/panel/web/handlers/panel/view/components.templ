package view

import "strconv"

// UpdateStatusProps holds data for the update status message.
type UpdateStatusProps struct {
	CollectorsNotified int
	Message            string
}

// UpdateStatus renders the update status response for the update button.
templ UpdateStatus(p UpdateStatusProps) {
	<span class="text-xs text-fg-secondary">{ p.Message }</span>
}

// StatsRow renders CPU, RAM, and Disk stats in a compact row.
templ StatsRow(stats *CollectorStatsView, showLink bool, collectorName string) {
	if stats != nil {
		<div class="flex flex-wrap items-center gap-4 mb-4 text-xs">
			<div class="flex items-center gap-1">
				<span class="text-fg-secondary">CPU:</span>
				<span class={ cpuClass(stats.CPUUsagePercent) }>{ strconv.FormatFloat(stats.CPUUsagePercent, 'f', 0, 64) }%</span>
			</div>
			<div class="flex items-center gap-1">
				<span class="text-fg-secondary">RAM:</span>
				<span class={ memClass(memPercent(stats.MemUsedMB, stats.MemTotalMB)) }>{ strconv.FormatFloat(memPercent(stats.MemUsedMB, stats.MemTotalMB), 'f', 0, 64) }%</span>
			</div>
			<div class="flex items-center gap-1">
				<span class="text-fg-secondary">Disk:</span>
				<span class={ diskClass(diskPercent(stats.DiskUsedGB, stats.DiskTotalGB)) }>{ strconv.FormatFloat(diskPercent(stats.DiskUsedGB, stats.DiskTotalGB), 'f', 0, 64) }%</span>
			</div>
			if showLink {
				<a hx-get={ "/panel/collectors/" + collectorName + "/resources" }
				   hx-target="body"
				   hx-push-url="true"
				   class="text-fg-secondary hover:text-fg cursor-pointer ml-auto"
				   title="View metrics history">
					Metrics <span class="text-fg-secondary">&rarr;</span>
				</a>
			}
		</div>
	} else {
		if showLink {
			<div class="flex items-center justify-between mb-4">
				<span class="text-fg-secondary text-xs">No stats available</span>
				<a hx-get={ "/panel/collectors/" + collectorName + "/resources" }
				   hx-target="body"
				   hx-push-url="true"
				   class="text-xs text-fg-secondary hover:text-fg cursor-pointer"
				   title="View metrics history">
					Metrics <span class="text-fg-secondary">&rarr;</span>
				</a>
			</div>
		} else {
			<div class="text-fg-secondary text-xs mb-4">No stats available</div>
		}
	}
}
