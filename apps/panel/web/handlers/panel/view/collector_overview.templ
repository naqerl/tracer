package view

import (
	"strconv"
	"tracer/apps/panel/web/templates"
)

type CollectorOverviewProps struct {
	Title         string
	CollectorName string
	Since         string
	Stats         *CollectorStatsView
}

// CollectorOverview renders the collector overview page
templ CollectorOverview(props CollectorOverviewProps) {
	@templates.Layout(props.Title, templates.NavData{Since: props.Since}) {
		<style>
			@keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
			.animate-pulse { animation: pulse 2s infinite; }
		</style>
		<div class="max-w-5xl mx-auto p-6">
			@CollectorOverviewContent(props)
		</div>
	}
}

// CollectorOverviewContent renders the collector overview content
templ CollectorOverviewContent(props CollectorOverviewProps) {
	@CollectorOverviewData(props)
}

// CollectorOverviewData renders the main data section for a collector
templ CollectorOverviewData(props CollectorOverviewProps) {
	<div class="mb-10">
		<!-- Collector Header -->
		<div class="flex items-center mb-2">
			<span class="text-fg-secondary text-xl mr-1">[</span>
			<h2 class="text-xl font-semibold">{ props.CollectorName }</h2>
			<span class="text-fg-secondary text-xl ml-1">]</span>
			<hr class="flex-1 mx-4 border-bg-secondary" />
			if props.Stats != nil {
				<span class="text-fg-secondary text-xs mr-1">[</span>
				if props.Stats.Staleness == "fresh" {
					<span class="text-xs text-fg">{ props.Stats.TimestampFormatted }</span>
				} else if props.Stats.Staleness == "warning" {
					<span class="text-xs text-yellow-400">{ props.Stats.TimestampFormatted }</span>
				} else {
					<span class="text-xs text-red-400">{ props.Stats.TimestampFormatted }</span>
				}
				<span class="text-fg-secondary text-xs ml-1">]</span>
			}
			<span class="text-xs text-fg-secondary mx-1">[</span>
			<a href={ "/panel/collectors/" + props.CollectorName + "/resources" }
			   class="text-xs text-accent hover:underline"
			   title="View resource usage history">
				resources
			</a>
			<span class="text-xs text-fg-secondary ml-1">]</span>
		</div>

		<!-- Stats Row -->
		if props.Stats != nil {
			<div class="flex flex-wrap items-center gap-4 mb-4 text-xs">
				<div class="flex items-center gap-1">
					<span class="text-fg-secondary">CPU:</span>
					<span class={ cpuClass(props.Stats.CPUUsagePercent) }>{ strconv.FormatFloat(props.Stats.CPUUsagePercent, 'f', 0, 64) }%</span>
				</div>
				<div class="flex items-center gap-1">
					<span class="text-fg-secondary">RAM:</span>
					<span class={ memClass(memPercent(props.Stats.MemUsedMB, props.Stats.MemTotalMB)) }>{ strconv.FormatFloat(memPercent(props.Stats.MemUsedMB, props.Stats.MemTotalMB), 'f', 0, 64) }%</span>
				</div>
				<div class="flex items-center gap-1">
					<span class="text-fg-secondary">Disk:</span>
					<span class={ diskClass(diskPercent(props.Stats.DiskUsedGB, props.Stats.DiskTotalGB)) }>{ strconv.FormatFloat(diskPercent(props.Stats.DiskUsedGB, props.Stats.DiskTotalGB), 'f', 0, 64) }%</span>
				</div>
			</div>
		} else {
			<div class="text-fg-secondary text-xs mb-4">No stats available</div>
		}

		<!-- Apps Grid -->
		<div
			hx-get={ "/panel/collectors/" + props.CollectorName + "/apps" }
			hx-trigger="load"
			hx-swap="outerHTML"
		>
			<div class="text-fg-secondary text-sm">Loading apps...</div>
		</div>
	</div>
}
