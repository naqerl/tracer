package view

import (
	"strconv"
	"time"
	"tracer/apps/panel/web/templates"
)

// LogProps holds data for the single log detail page.
type LogProps struct {
	Title         string
	CollectorName string
	AppName       string
	Log           LogEntryDetail
}

type LogEntryDetail struct {
	ID             int64
	Level          string
	Message        string
	Context        struct {
		Valid  bool
		String string
	}
	CreatedAt      time.Time
	TraceIDDisplay string
	GroupID        int64
}

// Log renders the single log detail page.
templ Log(props LogProps) {
	@templates.Layout(props.Title, templates.NavData{Since: "24h"}) {
		<div class="max-w-5xl mx-auto p-6">
			@LogContent(props)
		</div>
	}
}

// LogContent renders the log content.
templ LogContent(props LogProps) {
	<!-- Breadcrumb -->
	<div class="mb-6">
		<a href={ "/panel/collectors/" + props.CollectorName + "/apps/" + props.AppName + "/logs/groups/" + strconv.FormatInt(props.Log.GroupID, 10) }
		   class="text-sm text-fg-secondary hover:text-fg transition-colors">&larr; Back to group</a>
	</div>

	<!-- Log Header -->
	<div class="mb-6">
		@LogMessage(props.Log.Message, props.Log.Level)
	</div>

	<!-- Metadata -->
	<div class="mb-6">
		<h2 class="text-lg font-medium mb-4 pl-5">Metadata</h2>
		<div class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 text-sm pl-8">
			<span class="text-fg-secondary">Time:</span>
			<span>{ props.Log.CreatedAt.Format("2006-01-02 15:04:05") }</span>

			<span class="text-fg-secondary">Level:</span>
			<span class="uppercase">{ props.Log.Level }</span>

			<span class="text-fg-secondary">Trace ID:</span>
			<span class="font-mono break-all">{ props.Log.TraceIDDisplay }</span>
		</div>
	</div>

	<!-- Context -->
	if props.Log.Context.Valid {
		<div>
			<h2 class="text-lg font-medium mb-4 pl-5">Context</h2>
			<div class="pl-8">
				@templates.JSONViewerFull(props.Log.Context.String, props.Log.Context.Valid)
			</div>
		</div>
	}
}
