package view

import (
	"fmt"
	"html"
	"strconv"
	"strings"
	"time"
	"tracer/apps/panel/web/templates"
)

// LogProps holds data for the single log detail page.
type LogProps struct {
	Title         string
	CollectorName string
	AppName       string
	Log           LogEntryDetail
}

type LogEntryDetail struct {
	ID             int64
	Level          string
	Message        string
	Context        struct {
		Valid  bool
		String string
	}
	CreatedAt      time.Time
	TraceIDDisplay string
	GroupID        int64
}

// Log renders the single log detail page.
templ Log(props LogProps) {
	@templates.Layout(props.Title, templates.NavData{Since: "24h"}) {
		<div class="max-w-5xl mx-auto p-6">
			@LogContent(props)
		</div>
	}
}

// LogContent renders the log content.
templ LogContent(props LogProps) {
	<div class="mb-6">
		@templates.BackwardAnchor("/panel/collectors/"+props.CollectorName+"/apps/"+props.AppName+"/logs/groups/"+strconv.FormatInt(props.Log.GroupID, 10),
			"text-sm text-fg-secondary hover:text-fg transition-colors") {
			Back to group
		}
	</div>

	<!-- Log Header -->
	<div class="mb-6">
		@LogMessage(props.Log.Message, props.Log.Level)
	</div>

	<!-- Metadata -->
	<div class="mb-6">
		<h2 class="text-lg font-medium mb-4 pl-5">Metadata</h2>
		<div class="pl-8 text-sm whitespace-pre-line">@templ.Raw(logMetadataHTML(props.Log.CreatedAt, props.Log.Level, props.Log.TraceIDDisplay))</div>
	</div>

	<!-- Context -->
	if props.Log.Context.Valid {
		<div>
			<h2 class="text-lg font-medium mb-4 pl-5">Context</h2>
			<div class="pl-8">
				@templates.JSONViewerFull(props.Log.Context.String, props.Log.Context.Valid)
			</div>
		</div>
	}
}

// logMetadataHTML renders Time, Level, and Trace ID as pre-line text so each
// field lands on its own line in both the browser (whitespace-pre-line) and
// the markdown export.
// Label/value styling spans need the line breaks and separating spaces kept
// inside them: html-to-markdown drops whitespace-only text nodes between
// elements, which would glue the fields together in the export.
func logMetadataHTML(createdAt time.Time, level string, traceID string) string {
	if traceID == "" {
		traceID = "-"
	}
	var b strings.Builder
	fmt.Fprintf(&b, "<span class=\"text-fg-secondary\">Time:</span> %s", createdAt.Format("2006-01-02 15:04:05"))
	fmt.Fprintf(&b, "<span class=\"text-fg-secondary\">\nLevel:</span><span class=\"uppercase\"> %s</span>", html.EscapeString(level))
	fmt.Fprintf(&b, "<span class=\"text-fg-secondary\">\nTrace ID:</span><span class=\"font-mono break-all\"> %s</span>", html.EscapeString(traceID))
	return b.String()
}
