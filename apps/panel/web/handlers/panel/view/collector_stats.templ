package view

import (
	"fmt"
	"strconv"
	"time"
	"tracer/apps/panel/web/templates"
)

type CollectorStatsProps struct {
	Title         string
	CollectorName string
	Since         string
	Stats         []StatPoint
}

type StatPoint struct {
	CreatedAt       int64
	CpuUsagePercent float64
	MemUsedMb       int64
	MemTotalMb      int64
	DiskAvailGb     float64
}

// CollectorStats renders the collector stats/resources page with charts.
templ CollectorStats(props CollectorStatsProps) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			@templates.Head()
			<title>{ props.Title }</title>
			<style>
				.uplot { margin: 1.5rem 0; touch-action: pan-y pinch-zoom; }
				.stats-table { width: 100%; border-collapse: collapse; margin-top: 2rem; overflow-x: auto; display: block; -webkit-overflow-scrolling: touch; }
				.stats-table th, .stats-table td { padding: 0.5rem; text-align: left; border-bottom: 1px solid #1E1E1E; white-space: nowrap; }
				.stats-table th { font-weight: 500; color: #808080; font-size: 0.875rem; }
				.stats-table tr:hover { background-color: #1E1E1E; }
				@media (max-width: 640px) {
					.uplot { margin: 1rem 0; }
				}
			</style>
		</head>
		<body>
			@templates.Navbar(templates.NavData{Since: props.Since})
			<div class="max-w-5xl mx-auto p-6">
				@CollectorStatsContent(props)
			</div>
		</body>
	</html>
}

// CollectorStatsContent renders the content area.
templ CollectorStatsContent(props CollectorStatsProps) {
	<div class="mb-6">
		<h2 class="text-xl font-medium">{ props.CollectorName }</h2>
		<p class="text-base text-fg-secondary mt-1">Resource usage</p>
	</div>
	@CollectorStatsData(props)
}

// CollectorStatsData renders the stats data with charts and table.
templ CollectorStatsData(props CollectorStatsProps) {
	if len(props.Stats) > 0 {
		<!-- Charts Container -->
		<div id="charts-container">
			<div id="cpu-chart"></div>
			<div id="ram-chart"></div>
			<div id="disk-chart"></div>
		</div>

		<!-- Data Table -->
		<details class="mt-6">
			<summary class="cursor-pointer text-sm text-fg-secondary hover:text-fg transition-colors mb-2">Show raw data ({ strconv.Itoa(len(props.Stats)) } data points)</summary>
			<table id="stats-data" class="stats-table text-sm">
				<thead>
					<tr>
						<th>Time</th>
						<th>CPU %</th>
						<th>RAM Used</th>
						<th>RAM Total</th>
						<th>RAM %</th>
						<th>Disk Free</th>
					</tr>
				</thead>
				<tbody>
					for _, s := range props.Stats {
						<tr data-timestamp={ strconv.FormatInt(s.CreatedAt, 10) }
							data-cpu={ fmt.Sprintf("%f", s.CpuUsagePercent) }
							data-ram-used={ strconv.FormatInt(s.MemUsedMb, 10) }
							data-ram-total={ strconv.FormatInt(s.MemTotalMb, 10) }
							data-disk-avail={ fmt.Sprintf("%f", s.DiskAvailGb) }>
							<td>{ time.Unix(s.CreatedAt, 0).Format("2006-01-02 15:04:05") }</td>
							<td>{ fmt.Sprintf("%.1f", s.CpuUsagePercent) }%</td>
							<td>{ strconv.FormatInt(s.MemUsedMb, 10) } MB</td>
							<td>{ strconv.FormatInt(s.MemTotalMb, 10) } MB</td>
							<td>
								if s.MemTotalMb > 0 {
									{ fmt.Sprintf("%.1f", (float64(s.MemUsedMb)/float64(s.MemTotalMb))*100.0) }%
								} else {
									0%
								}
							</td>
							<td>{ fmt.Sprintf("%.1f", s.DiskAvailGb) } GB</td>
						</tr>
					}
				</tbody>
			</table>
		</details>

		<!-- Chart Rendering Script -->
		<script>
			(function() {
				function initCharts() {
					if (typeof uPlot === 'undefined') {
						setTimeout(initCharts, 50);
						return;
					}
					renderCharts();
				}
				
				function renderCharts() {
				const rows = document.querySelectorAll('#stats-data tbody tr');
				if (rows.length === 0) return;

				const timestamps = [];
				const cpuData = [];
				const ramUsedData = [];
				const ramTotalData = [];
				const diskData = [];

				rows.forEach(row => {
					timestamps.push(parseInt(row.dataset.timestamp));
					cpuData.push(parseFloat(row.dataset.cpu));
					ramUsedData.push(parseInt(row.dataset.ramUsed));
					ramTotalData.push(parseInt(row.dataset.ramTotal));
					diskData.push(parseInt(row.dataset.diskAvail));
				});

				const ramPercent = ramUsedData.map((used, i) => 
					ramTotalData[i] > 0 ? (used / ramTotalData[i]) * 100 : 0
				);

				const containerWidth = document.getElementById('charts-container').offsetWidth;
				const isMobile = window.innerWidth < 768;
				const commonOpts = {
					width: containerWidth,
					height: isMobile ? 200 : 250,
					scales: {
						x: { time: true }
					},
					axes: [
						{ 
							stroke: "#808080",
							grid: { stroke: "#1E1E1E", width: 1 },
							size: isMobile ? 40 : 50
						},
						{ 
							stroke: "#808080",
							size: isMobile ? 50 : 60,
							grid: { stroke: "#1E1E1E", width: 1 }
						}
					],
					legend: { show: false },
					cursor: {
						drag: { x: false, y: false },
						focus: { prox: isMobile ? 50 : 30 },
						points: {
							size: isMobile ? 6 : 8,
							width: 2
						}
					}
				};

				new uPlot({
					...commonOpts,
					title: "CPU Usage",
					series: [
						{ },
						{ 
							label: "CPU %", 
							stroke: "#5C9CF5", 
							fill: "rgba(92, 156, 245, 0.1)",
							width: 2
						}
					],
					axes: [
						commonOpts.axes[0],
						{ 
							...commonOpts.axes[1],
							values: (u, vals) => vals.map(v => v.toFixed(1) + '%')
						}
					],
				}, [timestamps, cpuData], document.getElementById('cpu-chart'));

				new uPlot({
					...commonOpts,
					title: "RAM Usage",
					series: [
						{ },
						{ 
							label: "RAM %", 
							stroke: "#F5A742", 
							fill: "rgba(245, 167, 66, 0.1)",
							width: 2
						}
					],
					axes: [
						commonOpts.axes[0],
						{ 
							...commonOpts.axes[1],
							values: (u, vals) => vals.map(v => v.toFixed(1) + '%')
						}
					],
				}, [timestamps, ramPercent], document.getElementById('ram-chart'));

				new uPlot({
					...commonOpts,
					title: "Disk Available",
					series: [
						{ },
						{ 
							label: "Free GB", 
							stroke: "#22C55E", 
							fill: "rgba(34, 197, 94, 0.1)",
							width: 2
						}
					],
					axes: [
						commonOpts.axes[0],
						{ 
							...commonOpts.axes[1],
							values: (u, vals) => vals.map(v => v.toFixed(0) + ' GB')
						}
					],
				}, [timestamps, diskData], document.getElementById('disk-chart'));

				let resizeTimeout;
				window.addEventListener('resize', () => {
					clearTimeout(resizeTimeout);
					resizeTimeout = setTimeout(() => {
						const newWidth = document.getElementById('charts-container').offsetWidth;
						const newIsMobile = window.innerWidth < 768;
						const newHeight = newIsMobile ? 200 : 250;
						
						const charts = document.querySelectorAll('.uplot');
						charts.forEach(chart => {
							const uplot = uPlot.charts.find(c => c.root === chart);
							if (uplot) {
								uplot.setSize({ 
									width: newWidth, 
									height: newHeight 
								});
							}
						});
					}, 150);
				});
				}
				
				initCharts();
			})();
		</script>
	} else {
		<div class="text-center text-sm text-fg-secondary/60 py-12">
			<p>No stats available for the selected time range.</p>
			<p class="mt-2">Stats are collected every 30 seconds when the collector is running.</p>
		</div>
	}
}
