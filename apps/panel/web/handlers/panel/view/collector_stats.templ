package view

import (
	"fmt"
	"strconv"
	"time"
	"tracer/apps/panel/web/templates"
)

type CollectorStatsProps struct {
	Title         string
	CollectorName string
	Since         string
	CPUPeriods    []CPUPeriodView
	MemPeriods    []MemPeriodView
	DiskPeriods   []DiskPeriodView
}

type CPUPeriodView struct {
	PeriodStart  int64
	PeriodEnd    int64 // 0 means still open
	UsagePercent float64
}

type MemPeriodView struct {
	PeriodStart int64
	PeriodEnd   int64 // 0 means still open
	UsedMb      int64
	TotalMb     int64
}

type DiskPeriodView struct {
	PeriodStart int64
	PeriodEnd   int64 // 0 means still open
	AvailGb     float64
}

// CollectorStats renders the collector stats/resources page with charts.
templ CollectorStats(props CollectorStatsProps) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			@templates.Head()
			<title>{ props.Title }</title>
			<style>
				.uplot { margin: 1.5rem 0; touch-action: pan-y pinch-zoom; }
				.stats-table { width: 100%; border-collapse: collapse; margin-top: 2rem; overflow-x: auto; display: block; -webkit-overflow-scrolling: touch; }
				.stats-table th, .stats-table td { padding: 0.5rem; text-align: left; border-bottom: 1px solid #1E1E1E; white-space: nowrap; }
				.stats-table th { font-weight: 500; color: #808080; font-size: 0.875rem; }
				.stats-table tr:hover { background-color: #1E1E1E; }
				@media (max-width: 640px) {
					.uplot { margin: 1rem 0; }
					.stats-table { font-size: 0.75rem; }
				}
			</style>
		</head>
		<body>
			@templates.Navbar(templates.NavData{Since: props.Since})
			<div class="max-w-5xl mx-auto p-6">
				@CollectorStatsContent(props)
			</div>
		</body>
	</html>
}

// CollectorStatsContent renders the content area.
templ CollectorStatsContent(props CollectorStatsProps) {
	<div class="mb-6">
		<h2 class="text-xl font-medium">{ props.CollectorName }</h2>
		<p class="text-base text-fg-secondary mt-1">Resource usage</p>
	</div>
	@CollectorStatsData(props)
}

// CollectorStatsData renders the stats data with charts and table.
templ CollectorStatsData(props CollectorStatsProps) {
	if len(props.CPUPeriods) > 0 || len(props.MemPeriods) > 0 || len(props.DiskPeriods) > 0 {
		<!-- Charts Container -->
		<div id="charts-container">
			<div id="cpu-chart"></div>
			<div id="ram-chart"></div>
			<div id="disk-chart"></div>
		</div>

		<!-- CPU Periods Table -->
		<details class="mt-6">
			<summary class="cursor-pointer text-sm text-fg-secondary hover:text-fg transition-colors mb-2">CPU Periods ({ strconv.Itoa(len(props.CPUPeriods)) })</summary>
			<table id="cpu-periods" class="stats-table text-sm">
				<thead>
					<tr>
						<th>From</th>
						<th>To</th>
						<th>CPU %</th>
					</tr>
				</thead>
				<tbody>
					for _, p := range props.CPUPeriods {
						<tr data-start={ strconv.FormatInt(p.PeriodStart, 10) }
						    data-end={ strconv.FormatInt(p.PeriodEnd, 10) }
						    data-value={ fmt.Sprintf("%f", p.UsagePercent) }>
							<td>{ time.Unix(p.PeriodStart, 0).Format("15:04:05") }</td>
							<td>
								if p.PeriodEnd > 0 {
									{ time.Unix(p.PeriodEnd, 0).Format("15:04:05") }
								} else {
									now
								}
							</td>
							<td>{ fmt.Sprintf("%.1f", p.UsagePercent) }%</td>
						</tr>
					}
				</tbody>
			</table>
		</details>

		<!-- Memory Periods Table -->
		<details class="mt-4">
			<summary class="cursor-pointer text-sm text-fg-secondary hover:text-fg transition-colors mb-2">Memory Periods ({ strconv.Itoa(len(props.MemPeriods)) })</summary>
			<table id="mem-periods" class="stats-table text-sm">
				<thead>
					<tr>
						<th>From</th>
						<th>To</th>
						<th>Used MB</th>
						<th>Total MB</th>
						<th>Used %</th>
					</tr>
				</thead>
				<tbody>
					for _, p := range props.MemPeriods {
						<tr data-start={ strconv.FormatInt(p.PeriodStart, 10) }
						    data-end={ strconv.FormatInt(p.PeriodEnd, 10) }
						    data-used={ strconv.FormatInt(p.UsedMb, 10) }
						    data-total={ strconv.FormatInt(p.TotalMb, 10) }>
							<td>{ time.Unix(p.PeriodStart, 0).Format("15:04:05") }</td>
							<td>
								if p.PeriodEnd > 0 {
									{ time.Unix(p.PeriodEnd, 0).Format("15:04:05") }
								} else {
									now
								}
							</td>
							<td>{ strconv.FormatInt(p.UsedMb, 10) } MB</td>
							<td>{ strconv.FormatInt(p.TotalMb, 10) } MB</td>
							<td>{
								func() string {
									if p.TotalMb > 0 {
										return fmt.Sprintf("%.1f", (float64(p.UsedMb)/float64(p.TotalMb))*100.0)
									}
									return "0.0"
								}()
							}%</td>
						</tr>
					}
				</tbody>
			</table>
		</details>

		<!-- Disk Periods Table -->
		<details class="mt-4">
			<summary class="cursor-pointer text-sm text-fg-secondary hover:text-fg transition-colors mb-2">Disk Periods ({ strconv.Itoa(len(props.DiskPeriods)) })</summary>
			<table id="disk-periods" class="stats-table text-sm">
				<thead>
					<tr>
						<th>From</th>
						<th>To</th>
						<th>Available GB</th>
					</tr>
				</thead>
				<tbody>
					for _, p := range props.DiskPeriods {
						<tr data-start={ strconv.FormatInt(p.PeriodStart, 10) }
						    data-end={ strconv.FormatInt(p.PeriodEnd, 10) }
						    data-value={ fmt.Sprintf("%f", p.AvailGb) }>
							<td>{ time.Unix(p.PeriodStart, 0).Format("15:04:05") }</td>
							<td>
								if p.PeriodEnd > 0 {
									{ time.Unix(p.PeriodEnd, 0).Format("15:04:05") }
								} else {
									now
								}
							</td>
							<td>{ fmt.Sprintf("%.1f", p.AvailGb) } GB</td>
						</tr>
					}
				</tbody>
			</table>
		</details>

		<!-- Chart Rendering Script -->
		<script>
			(function() {
				function initCharts() {
					if (typeof uPlot === 'undefined') {
						setTimeout(initCharts, 50);
						return;
					}
					renderCharts();
				}
				
				function renderCharts() {
				const containerWidth = document.getElementById('charts-container').offsetWidth;
				const isMobile = window.innerWidth < 768;
				const commonOpts = {
					width: containerWidth,
					height: isMobile ? 200 : 250,
					scales: {
						x: { time: true }
					},
					axes: [
						{ 
							stroke: "#808080",
							grid: { stroke: "#1E1E1E", width: 1 },
							size: isMobile ? 40 : 50
						},
						{ 
							stroke: "#808080",
							size: isMobile ? 50 : 60,
							grid: { stroke: "#1E1E1E", width: 1 }
						}
					],
					legend: { show: false },
					cursor: {
						drag: { x: false, y: false },
						focus: { prox: isMobile ? 50 : 30 },
						points: {
							size: isMobile ? 6 : 8,
							width: 2
						}
					}
				};

				// Store chart instances for resize handling
				const instances = [];

				// Build stepped data from periods: each period becomes two points (start, end)
				// For open periods (end=0), emit current time as endpoint so the line extends to "now"
				function periodsToSeries(rows, valueKey) {
					const timestamps = [];
					const values = [];
					rows.forEach(row => {
						const start = parseInt(row.dataset.start);
						const end = parseInt(row.dataset.end);
						const val = parseFloat(row.dataset[valueKey]);
						timestamps.push(start);
						values.push(val);
						if (end > 0) {
							timestamps.push(end);
							values.push(val);
						} else {
							// Open period: extend to current time
							timestamps.push(Math.floor(Date.now() / 1000));
							values.push(val);
						}
					});
					// Sort by timestamp
					const indices = timestamps.map((_, i) => i).sort((a, b) => timestamps[a] - timestamps[b]);
					return [
						indices.map(i => timestamps[i]),
						indices.map(i => values[i])
					];
				}

				const cpuRows = document.querySelectorAll('#cpu-periods tbody tr');
				if (cpuRows.length > 0) {
					const [cpuTs, cpuVals] = periodsToSeries(cpuRows, 'value');
					instances.push(new uPlot({
						...commonOpts,
						title: "CPU Usage",
						series: [
							{ },
							{ 
								label: "CPU %", 
								stroke: "#5C9CF5", 
								fill: "rgba(92, 156, 245, 0.1)",
								width: 2
							}
						],
						axes: [
							commonOpts.axes[0],
							{ 
								...commonOpts.axes[1],
								values: (u, vals) => vals.map(v => v.toFixed(1) + '%')
							}
						],
					}, [cpuTs, cpuVals], document.getElementById('cpu-chart')));
				}

				const memRows = document.querySelectorAll('#mem-periods tbody tr');
				if (memRows.length > 0) {
					const timestamps = [];
					const values = [];
					memRows.forEach(row => {
						const start = parseInt(row.dataset.start);
						const end = parseInt(row.dataset.end);
						const total = parseInt(row.dataset.total);
						const used = parseInt(row.dataset.used);
						const pct = total > 0 ? (used / total) * 100 : 0;
						timestamps.push(start);
						values.push(pct);
						if (end > 0) {
							timestamps.push(end);
							values.push(pct);
						} else {
							// Open period: extend to current time
							timestamps.push(Math.floor(Date.now() / 1000));
							values.push(pct);
						}
					});
					const indices = timestamps.map((_, i) => i).sort((a, b) => timestamps[a] - timestamps[b]);
					const sortedTs = indices.map(i => timestamps[i]);
					const sortedVals = indices.map(i => values[i]);

					instances.push(new uPlot({
						...commonOpts,
						title: "RAM Usage",
						series: [
							{ },
							{ 
								label: "RAM %", 
								stroke: "#F5A742", 
								fill: "rgba(245, 167, 66, 0.1)",
								width: 2
							}
						],
						axes: [
							commonOpts.axes[0],
							{ 
								...commonOpts.axes[1],
								values: (u, vals) => vals.map(v => v.toFixed(1) + '%')
							}
						],
					}, [sortedTs, sortedVals], document.getElementById('ram-chart')));
				}

				const diskRows = document.querySelectorAll('#disk-periods tbody tr');
				if (diskRows.length > 0) {
					const [diskTs, diskVals] = periodsToSeries(diskRows, 'value');
					instances.push(new uPlot({
						...commonOpts,
						title: "Disk Available",
						series: [
							{ },
							{ 
								label: "Free GB", 
								stroke: "#22C55E", 
								fill: "rgba(34, 197, 94, 0.1)",
								width: 2
							}
						],
						axes: [
							commonOpts.axes[0],
							{ 
								...commonOpts.axes[1],
								values: (u, vals) => vals.map(v => v.toFixed(0) + ' GB')
							}
						],
					}, [diskTs, diskVals], document.getElementById('disk-chart')));
				}

				let resizeTimeout;
				window.addEventListener('resize', () => {
					clearTimeout(resizeTimeout);
					resizeTimeout = setTimeout(() => {
						const newWidth = document.getElementById('charts-container').offsetWidth;
						const newIsMobile = window.innerWidth < 768;
						const newHeight = newIsMobile ? 200 : 250;
						
						instances.forEach(u => {
							u.setSize({ 
								width: newWidth, 
								height: newHeight 
							});
						});
					}, 150);
				});
				}
				
				initCharts();
			})();
		</script>
	} else {
		<div class="text-center text-sm text-fg-secondary/60 py-12">
			<p>No stats available for the selected time range.</p>
			<p class="mt-2">Stats are collected every 30 seconds when the collector is running.</p>
		</div>
	}
}
