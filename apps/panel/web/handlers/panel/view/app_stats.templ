package view

import (
	"strconv"
)

// AppStatsProps holds data for the app stats fragment.
type AppStatsProps struct {
	Stats AppStatsData
}

// AppStatsData carries the log counts for the overview cards. HasLogs is
// false when the app never received a log, in which case the counts render
// as "N/A".
type AppStatsData struct {
	HasLogs  bool
	Total    int64
	Errors   int64
	Warnings int64
	Infos    int64
}

// statValue formats a log count, or "N/A" when the app has no logs.
func statValue(hasLogs bool, v int64) string {
	if !hasLogs {
		return "N/A"
	}
	return strconv.FormatInt(v, 10)
}

// statClass returns the card accent for a log count, muted when the app has
// no logs or the count is zero.
func statClass(hasLogs bool, v int64, accent string) string {
	if !hasLogs || v == 0 {
		return "text-fg-secondary"
	}
	if accent == "" {
		return "text-fg-secondary"
	}
	return accent
}

// AppStatsSkeleton renders placeholder stat cards matching AppStats (same
// grid, same p-4 cards, bars sized to text-2xl/text-xs line boxes and the
// same mt-2 gap) so the fragment swap does not shift the page height.
templ AppStatsSkeleton() {
	<div id="app-stats" aria-hidden="true">
		<h2 class="text-lg font-medium mb-4">Overview</h2>
		<div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
			for i := 0; i < 4; i++ {
				<div class="bg-bg-secondary p-4 text-center">
					<div class="animate-pulse" aria-hidden="true">
						<div class="mx-auto h-8 w-14 rounded bg-fg/10"></div>
						<div class="mx-auto mt-2 h-4 w-16 rounded bg-fg/10"></div>
					</div>
				</div>
			}
		</div>
	</div>
}

// AppStats renders the app stats overview fragment. The counts carry the
// value-breath class so they brighten on each 15s refresh while the labels
// stay static.
templ AppStats(props AppStatsProps) {
	<div id="app-stats">
		<h2 class="text-lg font-medium mb-4">Overview</h2>
		<div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
			<div class="bg-bg-secondary p-4 text-center">
				<div class={ "text-2xl font-bold value-breath " + statClass(props.Stats.HasLogs, props.Stats.Total, "") }>{ statValue(props.Stats.HasLogs, props.Stats.Total) }</div>
				<div class="mt-2 text-xs text-fg-secondary">Total Logs</div>
			</div>
			<div class="bg-bg-secondary p-4 text-center">
				<div class={ "text-2xl font-bold value-breath " + statClass(props.Stats.HasLogs, props.Stats.Errors, "text-red-400") }>{ statValue(props.Stats.HasLogs, props.Stats.Errors) }</div>
				<div class="mt-2 text-xs text-fg-secondary">Errors</div>
			</div>
			<div class="bg-bg-secondary p-4 text-center">
				<div class={ "text-2xl font-bold value-breath " + statClass(props.Stats.HasLogs, props.Stats.Warnings, "text-yellow-400") }>{ statValue(props.Stats.HasLogs, props.Stats.Warnings) }</div>
				<div class="mt-2 text-xs text-fg-secondary">Warnings</div>
			</div>
			<div class="bg-bg-secondary p-4 text-center">
				<div class={ "text-2xl font-bold value-breath " + statClass(props.Stats.HasLogs, props.Stats.Infos, "text-blue-400") }>{ statValue(props.Stats.HasLogs, props.Stats.Infos) }</div>
				<div class="mt-2 text-xs text-fg-secondary">Info</div>
			</div>
		</div>
	</div>
}
