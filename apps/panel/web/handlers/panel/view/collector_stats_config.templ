package view

import (
	"fmt"
	"strconv"
	"tracer/apps/panel/web/templates"
)

// StatsConfigProps carries the state for the metrics collection
// configuration form.
type StatsConfigProps struct {
	Title     string
	Collector string
	Interval  string
	CPU       bool
	Mem       bool
	Disk      bool

	// Per-collector resource monitoring overrides. A nil pointer means
	// "use global default"; the form shows the global value as placeholder.
	CPUDeltaPercent       *float64
	MemDeltaKB            *int
	DiskDeltaKB           *int
	CPUThresholdPercent   *float64
	MemThresholdPercent   *float64
	DiskThresholdPercent  *float64
	ResourceNotifyMinutes *int

	Status   string
	StatusOK bool
}

// StatsConfigPage renders the full-page metrics configuration form.
templ StatsConfigPage(p StatsConfigProps) {
	@templates.Layout(p.Title, templates.NavData{Since: "24h"}) {
		<div class="max-w-4xl mx-auto p-2 md:p-6">
			<h1 class="text-xl font-semibold mb-6">Metrics config - { p.Collector }</h1>
			<a href={ "/panel/collectors/" + p.Collector + "/resources" } onclick="if (window.history.length > 1) { window.history.back(); return false; }" class="text-fg-secondary hover:text-fg text-sm mb-6 inline-block">&lt; back</a>
			<div id="stats-config-container" class="space-y-6">
				if p.Status != "" {
					<div class={ "border p-4 " + tern(p.StatusOK, "border-green-500/30", "border-red-500/30") }>
						<span class={ "text-sm " + tern(p.StatusOK, "text-green-400", "text-red-400") }>{ p.Status }</span>
					</div>
				}
				<form
					hx-post={ "/panel/collectors/" + p.Collector + "/stats/configure" }
					hx-target="#stats-config-container"
					hx-swap="innerHTML"
					class="space-y-6">
					<div class="border border-bg-secondary/70 p-4">
						<h3 class="text-fg font-medium mb-3">Collect interval</h3>
						<select name="interval" style="color-scheme: dark" class="w-full bg-bg text-fg border border-fg/20 focus:border-fg/60 focus:outline-none px-2 py-2 text-base">
							<option class="bg-bg text-fg" value="10s" selected?={ p.Interval == "10s" }>Every 10 seconds</option>
							<option class="bg-bg text-fg" value="30s" selected?={ p.Interval == "30s" || p.Interval == "" }>Every 30 seconds</option>
							<option class="bg-bg text-fg" value="60s" selected?={ p.Interval == "60s" }>Every 60 seconds</option>
							<option class="bg-bg text-fg" value="300s" selected?={ p.Interval == "300s" }>Every 5 minutes</option>
							<option class="bg-bg text-fg" value="900s" selected?={ p.Interval == "900s" }>Every 15 minutes</option>
						</select>
						<p class="text-xs text-fg-secondary mt-1">How often the collector samples resource usage.</p>
					</div>
					<div class="border border-bg-secondary/70 p-4">
						<h3 class="text-fg font-medium mb-3">Metrics to collect</h3>
						<p class="text-xs text-fg-secondary mb-3">Enable or disable individual resource metrics. Disabled metrics are not sampled or reported.</p>
						<div class="space-y-3">
							@templates.MarkdownCheckbox("cpu", "cpu", "CPU usage", "on", p.CPU, 0)
							@templates.MarkdownCheckbox("mem", "mem", "Memory usage", "on", p.Mem, 0)
							@templates.MarkdownCheckbox("disk", "disk", "Disk usage", "on", p.Disk, 0)
						</div>
					</div>
					<div class="border border-bg-secondary/70 p-4">
						<h3 class="text-fg font-medium mb-3">Period deltas</h3>
						<p class="text-xs text-fg-secondary mb-3">Minimum change to close the current period and open a new one. Leave empty to use the panel-wide default.</p>
						<div class="grid grid-cols-3 gap-4">
							<div>
								<label class="block text-sm text-fg-secondary mb-1">CPU Delta (%)</label>
								<input type="number" name="cpu_delta_percent" step="0.1" min="0" value={ floatPtrStr(p.CPUDeltaPercent) } placeholder={ globalPlaceholder("1.0") }
								       class="w-full bg-transparent border-b border-fg/20 focus:border-fg/60 focus:outline-none px-2 py-2 text-base text-fg"/>
							</div>
							<div>
								<label class="block text-sm text-fg-secondary mb-1">Memory Delta (KB)</label>
								<input type="number" name="mem_delta_kb" min="0" value={ intPtrStr(p.MemDeltaKB) } placeholder={ globalPlaceholder("64") }
								       class="w-full bg-transparent border-b border-fg/20 focus:border-fg/60 focus:outline-none px-2 py-2 text-base text-fg"/>
							</div>
							<div>
								<label class="block text-sm text-fg-secondary mb-1">Disk Delta (KB)</label>
								<input type="number" name="disk_delta_kb" min="0" value={ intPtrStr(p.DiskDeltaKB) } placeholder={ globalPlaceholder("1024") }
								       class="w-full bg-transparent border-b border-fg/20 focus:border-fg/60 focus:outline-none px-2 py-2 text-base text-fg"/>
							</div>
						</div>
					</div>
					<div class="border border-bg-secondary/70 p-4">
						<h3 class="text-fg font-medium mb-3">Alert thresholds</h3>
						<p class="text-xs text-fg-secondary mb-3">Usage percentage above which a notification fires. 0 or empty disables. Leave empty to use the panel-wide default.</p>
						<div class="grid grid-cols-3 gap-4">
							<div>
								<label class="block text-sm text-fg-secondary mb-1">CPU Threshold (%)</label>
								<input type="number" name="cpu_threshold_percent" step="1" min="0" max="100" value={ floatPtrStr(p.CPUThresholdPercent) } placeholder={ globalPlaceholder("0") }
								       class="w-full bg-transparent border-b border-fg/20 focus:border-fg/60 focus:outline-none px-2 py-2 text-base text-fg"/>
							</div>
							<div>
								<label class="block text-sm text-fg-secondary mb-1">Memory Threshold (%)</label>
								<input type="number" name="mem_threshold_percent" step="1" min="0" max="100" value={ floatPtrStr(p.MemThresholdPercent) } placeholder={ globalPlaceholder("0") }
								       class="w-full bg-transparent border-b border-fg/20 focus:border-fg/60 focus:outline-none px-2 py-2 text-base text-fg"/>
							</div>
							<div>
								<label class="block text-sm text-fg-secondary mb-1">Disk Threshold (%)</label>
								<input type="number" name="disk_threshold_percent" step="1" min="0" max="100" value={ floatPtrStr(p.DiskThresholdPercent) } placeholder={ globalPlaceholder("0") }
								       class="w-full bg-transparent border-b border-fg/20 focus:border-fg/60 focus:outline-none px-2 py-2 text-base text-fg"/>
							</div>
						</div>
					</div>
					<div class="border border-bg-secondary/70 p-4">
						<h3 class="text-fg font-medium mb-3">Notification cooldown</h3>
						<p class="text-xs text-fg-secondary mb-3">Minimum minutes between resource notifications per collector+resource while a breach persists. Leave empty to use the panel-wide default.</p>
						<div>
							<label class="block text-sm text-fg-secondary mb-1">Once per (minutes)</label>
							<input type="number" name="resource_notify_minutes" min="0" value={ intPtrStr(p.ResourceNotifyMinutes) } placeholder={ globalPlaceholder("10") }
							       class="w-full bg-transparent border-b border-fg/20 focus:border-fg/60 focus:outline-none px-2 py-2 text-base text-fg"/>
						</div>
					</div>
					<div class="flex gap-2">
						<button type="submit" class="text-sm text-fg border border-fg px-4 py-2 hover:bg-fg hover:text-bg transition-colors">Save metrics config</button>
						<a href={ "/panel/collectors/" + p.Collector + "/resources" } onclick="if (window.history.length > 1) { window.history.back(); return false; }" class="text-sm text-fg-secondary border border-bg-secondary px-4 py-2 hover:text-fg transition-colors inline-block">Cancel</a>
					</div>
				</form>
			</div>
		</div>
		@templates.MarkdownCheckboxScript()
	}
}

func floatPtrStr(v *float64) string {
	if v == nil {
		return ""
	}
	return fmt.Sprintf("%.1f", *v)
}

func intPtrStr(v *int) string {
	if v == nil {
		return ""
	}
	return strconv.Itoa(*v)
}

func globalPlaceholder(val string) string {
	return "global: " + val
}

// StatsConfigSavedProps carries the state for the metrics config success
// view.
type StatsConfigSavedProps struct {
	Collector string
}

// StatsConfigSaved renders the success view after saving metrics config.
templ StatsConfigSaved(p StatsConfigSavedProps) {
	<div class="border border-green-500/30 p-4 mb-4">
		<div class="text-green-400 font-medium mb-2">✓ Metrics config saved</div>
		<div class="text-sm text-fg-secondary mb-3">The configuration has been pushed to collector "{ p.Collector }".</div>
		<div class="flex gap-2">
			<a
				href={ "/panel/collectors/" + p.Collector + "/resources" }
				class="text-sm text-fg border border-fg px-4 py-2 hover:bg-fg hover:text-bg transition-colors inline-block"
			>
				Back to metrics
			</a>
			<a
				href={ "/panel/collectors/" + p.Collector }
				class="text-sm text-fg-secondary border border-bg-secondary px-4 py-2 hover:text-fg transition-colors inline-block"
			>
				Collector
			</a>
		</div>
	</div>
}
