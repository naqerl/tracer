package view

// CollectorAppsProps holds data for the collector apps view (HTMX fragment).
type CollectorAppsProps struct {
	CollectorName string
	Apps          []AppView
}

// AppView is an app card in the apps grid; UptimeClass/ErrorClass carry the
// health color-coding. ErrorText carries the formatted error count or "N/A"
// when the app never received logs.
type AppView struct {
	Name        string
	UptimeText  string
	UptimeClass string
	ErrorText   string
	ErrorClass  string
	LastUpdate  LastUpdateView
}

// AppCard renders a single app card in the apps grid. When loading it renders
// the card shell with placeholder bars and a breath animation; otherwise it
// renders the app link with its uptime and error stats. The placeholder bars
// match the real card's line boxes (font-medium = 24px, text-xs = 16px) so
// the swap does not change the grid height.
templ AppCard(collectorName string, app AppView, loading bool) {
	<div class="block bg-bg-secondary p-4">
		if loading {
			<div class="animate-pulse" aria-hidden="true">
				<div class="h-6 w-2/3 rounded bg-fg/10"></div>
				<div class="mt-2 h-4 w-1/2 rounded bg-fg/10"></div>
			</div>
		} else {
			<a href={ "/panel/collectors/" + collectorName + "/apps/" + app.Name } class="block hover:bg-bg-secondary/80 transition-all hover:-translate-y-0.5">
				<div class="flex items-center justify-between gap-2">
					<div class="font-medium truncate">{ app.Name }</div>
					@LastUpdateBadge(app.LastUpdate)
				</div>
				<div class="mt-2 text-xs text-fg-secondary">
					<span>uptime: <span class={ "inline-block w-[3ch] tabular-nums text-right whitespace-nowrap value-breath " + app.UptimeClass }>{ app.UptimeText }</span></span>
					<span class="text-fg-secondary"> | </span>
					<span>errors: <span class={ "inline-block w-[3ch] tabular-nums text-left whitespace-nowrap value-breath " + app.ErrorClass }>{ app.ErrorText }</span></span>
				</div>
			</a>
		}
	</div>
}

// CollectorAppsSkeleton renders placeholder app cards matching the apps grid,
// including the trailing "Add app" entry so the swap does not resize the grid.
// When no apps are accessible a single bar matching the empty-state line
// height is shown.
templ CollectorAppsSkeleton(count int) {
	if count > 0 {
		<div class="apps-grid" aria-hidden="true">
			for i := 0; i < count; i++ {
				@AppCard("", AppView{}, true)
			}
			<div class="block bg-bg-secondary p-4 flex items-center justify-center">
				<div class="w-6 h-6 rounded bg-fg/10 animate-pulse"></div>
			</div>
		</div>
	} else {
		<div class="h-5 w-40 rounded bg-fg/10 animate-pulse" aria-hidden="true"></div>
	}
}

// CollectorApps renders the apps grid for a collector with uptime and
// error-count stats.
templ CollectorApps(props CollectorAppsProps) {
		if len(props.Apps) > 0 {
		<div class="apps-grid">
			for _, app := range props.Apps {
				@AppCard(props.CollectorName, app, false)
			}
			<a href={ "/panel/collectors/" + props.CollectorName + "/apps/new" } class="block bg-bg-secondary p-4 flex items-center justify-center hover:bg-bg-secondary/80 transition-all hover:-translate-y-0.5" aria-label="Add app">
				<img src="/static/img/plus.svg" alt="Add app" class="w-6 h-6"/>
			</a>
		</div>
	} else {
		<div class="text-fg-secondary text-sm">No apps registered</div>
	}
}
