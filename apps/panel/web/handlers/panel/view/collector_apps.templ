package view

import "strconv"

// CollectorAppsProps holds data for the collector apps view (HTMX fragment).
type CollectorAppsProps struct {
	CollectorName string
	Apps          []AppView
}

// AppView is an app card in the apps grid; UptimeClass/ErrorClass carry the
// health color-coding.
type AppView struct {
	Name        string
	UptimeText  string
	UptimeClass string
	ErrorCount  int64
	ErrorClass  string
}

// AppCard renders a single app card in the apps grid. When loading it renders
// the card shell with placeholder bars and a breath animation; otherwise it
// renders the app link with its uptime and error stats.
templ AppCard(collectorName string, app AppView, loading bool) {
	<div class="block bg-bg-secondary p-4">
		if loading {
			<div class="animate-pulse" aria-hidden="true">
				<div class="h-4 w-2/3 rounded bg-fg/10"></div>
				<div class="mt-2 h-4 w-1/2 rounded bg-fg/10"></div>
			</div>
		} else {
			<a href={ "/panel/collectors/" + collectorName + "/apps/" + app.Name } class="block hover:bg-bg-secondary/80 transition-all hover:-translate-y-0.5">
				<div class="font-medium">{ app.Name }</div>
				<div class="mt-2 text-xs text-fg-secondary">
					<span>uptime: <span class={ "inline-block w-[3ch] tabular-nums text-right whitespace-nowrap " + app.UptimeClass }>{ app.UptimeText }</span></span>
					<span class="text-fg-secondary"> | </span>
					<span>errors: <span class={ "inline-block w-[3ch] tabular-nums text-left whitespace-nowrap " + app.ErrorClass }>{ strconv.FormatInt(app.ErrorCount, 10) }</span></span>
				</div>
			</a>
		}
	</div>
}

// CollectorAppsSkeleton renders placeholder app cards matching the apps grid.
// When no apps are accessible a single bar matching the empty-state line
// height is shown.
templ CollectorAppsSkeleton(count int) {
	if count > 0 {
		<div class="apps-grid" aria-hidden="true">
			for i := 0; i < count; i++ {
				@AppCard("", AppView{}, true)
			}
		</div>
	} else {
		<div class="h-5 w-40 rounded bg-fg/10 animate-pulse" aria-hidden="true"></div>
	}
}

// CollectorApps renders the apps grid for a collector with uptime and
// error-count stats.
templ CollectorApps(props CollectorAppsProps) {
	if len(props.Apps) > 0 {
		<div class="apps-grid">
			for _, app := range props.Apps {
				@AppCard(props.CollectorName, app, false)
			}
		</div>
	} else {
		<div class="text-fg-secondary text-sm">No apps registered</div>
	}
}
