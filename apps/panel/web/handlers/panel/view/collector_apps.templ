package view

import (
	"tracer/apps/panel/internal/services/panel"
)

// CollectorAppsProps holds data for the collector apps view (HTMX fragment).
type CollectorAppsProps struct {
	CollectorName string
	Apps          []AppView
}

// AppView is an app card in the apps grid; Bars carry the uptime bar
// visualization. ErrorCount/ErrorTrend/ErrorTrendClass carry the error
// stats and trend indicator.
type AppView struct {
	Name            string
	HasUptime       bool
	HasLogSource    bool
	Bars            []UptimeBarView
	ErrorCount      string
	ErrorTrend      string
	ErrorTrendClass string
	ErrorTrendUp    bool
	LastUpdate      LastUpdateView
}

// AppCard renders a single app card in the apps grid. While loading it renders
// the same box as the loaded card with placeholder rectangles standing in for
// the name, the meta line and the uptime bars, so the swap neither resizes the
// card nor moves the page around it.
templ AppCard(collectorName string, app AppView, loading bool) {
	if loading {
		<div class="block bg-bg-secondary p-3 flex flex-col gap-2 relative animate-pulse" aria-hidden="true">
			@appCardBody(app, true)
		</div>
	} else {
		<a href={ "/panel/collectors/" + collectorName + "/apps/" + app.Name } class="block bg-bg-secondary p-3 flex flex-col gap-2 hover:bg-bg-secondary/80 transition-all hover:-translate-y-0.5 relative">
			@appCardBody(app, false)
		</a>
	}
}

// CollectorAppsSkeleton renders placeholder app cards matching the apps grid.
// When no apps are accessible a single bar matching the empty-state line
// height is shown.
templ CollectorAppsSkeleton(count int) {
	if count > 0 {
		<div class="apps-grid" aria-hidden="true">
			for i := 0; i < count; i++ {
				@AppCard("", AppView{}, true)
			}
		</div>
	} else {
		<div class="h-5 w-40 rounded bg-fg/10 animate-pulse" aria-hidden="true"></div>
	}
}

// CollectorApps renders the apps grid for a collector with uptime and
// error-count stats.
templ CollectorApps(props CollectorAppsProps) {
	<div class="apps-grid">
		for _, app := range props.Apps {
			@AppCard(props.CollectorName, app, false)
		}
	</div>
}

// appCardBody renders the lines and uptime bars shared by the loading and the
// loaded app card. Every line keeps the box of the real one; only its content
// turns into a placeholder rectangle while loading.
templ appCardBody(app AppView, loading bool) {
	<div class="flex flex-col min-w-0">
		<div class="font-medium truncate">
			if loading {
				<div class="h-6 w-24 rounded bg-fg/10"></div>
			} else {
				{ app.Name }
			}
		</div>
		<div class="flex items-center gap-2 text-xs min-w-0">
			if loading {
				<div class="h-4 w-16 rounded bg-fg/10"></div>
			} else if app.ErrorTrend != "" {
				<span class="whitespace-nowrap value-breath">
					<span class="text-fg-secondary">errors</span>
					<span class={ app.ErrorTrendClass }>{ app.ErrorTrend }
						if app.ErrorTrendUp {
							<svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="inline-block align-middle"><path d="M13 5H19V11"/><path d="M19 5L5 19"/></svg>
						} else {
							<svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="inline-block align-middle"><path d="M19 13V19H13"/><path d="M5 5L19 19"/></svg>
						}
					</span>
				</span>
			} else if app.ErrorCount != "" {
				<span class="whitespace-nowrap value-breath">
					<span class="text-fg-secondary">errors</span> <span class="text-fg">{ app.ErrorCount }</span>
				</span>
			} else if !app.HasLogSource {
				<span class="whitespace-nowrap text-xs text-fg-secondary">logs are not configured</span>
			}
			if !loading && app.LastUpdate.Class == "text-red-400" {
				<span class="whitespace-nowrap value-breath">
					<span class="text-xs text-fg-secondary">last log</span> <span class="text-xs text-red-400/80">{ app.LastUpdate.Text }</span>
				</span>
			}
		</div>
	</div>
	<div class="relative">
		if loading {
			@UptimeBars(placeholderUptimeBars(), "sm", "dots")
		} else if app.HasUptime {
			@UptimeBars(app.Bars, "sm", "dots")
		} else {
			<div class="relative">
				<div class="blur-sm pointer-events-none">
					@UptimeBars(app.Bars, "sm", "dots")
				</div>
				<div class="absolute inset-0 flex items-center justify-center">
					<span class="text-xs text-fg-secondary">uptime is not configured</span>
				</div>
			</div>
		}
	</div>
}

// placeholderUptimeBars returns the bars a skeleton card renders: as many as a
// loaded card does, so the dots of the card keep their size.
func placeholderUptimeBars() []UptimeBarView {
	bars := make([]UptimeBarView, panel.HealthBucketCount)
	for i := range bars {
		bars[i] = UptimeBarView{Class: "bg-fg/10"}
	}
	return bars
}
