package view

import "strconv"

// CollectorAppsProps holds data for the collector apps view (HTMX fragment).
type CollectorAppsProps struct {
	CollectorName string
	Apps          []AppView
}

// AppView is an app card in the apps grid; UptimeClass/ErrorClass carry the
// health color-coding.
type AppView struct {
	Name        string
	UptimeText  string
	UptimeClass string
	ErrorCount  int64
	ErrorClass  string
}

// CollectorApps renders the apps grid for a collector with uptime and
// error-count stats.
templ CollectorApps(props CollectorAppsProps) {
	if len(props.Apps) > 0 {
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
			for _, app := range props.Apps {
				<a href={ "/panel/collectors/" + props.CollectorName + "/apps/" + app.Name } class="block bg-bg-secondary hover:bg-bg-secondary/80 p-4 transition-all hover:-translate-y-0.5">
					<div class="font-medium">{ app.Name }</div>
					<div class="mt-2 text-xs text-fg-secondary">
						<span>uptime: <span class={ "inline-block w-[3ch] tabular-nums text-right whitespace-nowrap " + app.UptimeClass }>{ app.UptimeText }</span></span>
						<span class="text-fg-secondary"> | </span>
						<span>errors: <span class={ "inline-block w-[3ch] tabular-nums text-left whitespace-nowrap " + app.ErrorClass }>{ strconv.FormatInt(app.ErrorCount, 10) }</span></span>
					</div>
				</a>
			}
		</div>
	} else {
		<div class="text-fg-secondary text-sm">No apps registered</div>
	}
}
