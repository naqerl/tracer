package view

// AppHealthProps holds data for the app health fragment.
type AppHealthProps struct {
	Health AppHealthView
}

type AppHealthView struct {
	UptimeText      string
	UptimeTextClass string
	Bars            []UptimeBarView
}

type UptimeBarView struct {
	Class string
	Title string
}

// AppHealth renders the uptime percentage fragment.
templ AppHealth(props AppHealthProps) {
	<span>uptime: </span>
	<span class={ "inline-block w-[3ch] tabular-nums text-right whitespace-nowrap " + props.Health.UptimeTextClass }>
		if props.Health.UptimeText != "" {
			{ props.Health.UptimeText }
		} else {
			N/A
		}
	</span>
}
