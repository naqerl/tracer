package view

import (
	"time"
	"tracer/apps/panel/web/templates"
)

// CollectorView represents a collector on the dashboard.
type CollectorView struct {
	Name        string
	RemoteAddr  string
	IsConnected bool
	ConnectedAt time.Time
	LastSeenAt  time.Time
	Stats       *CollectorStatsView
}

// CollectorStatsView represents collector resource stats.
type CollectorStatsView struct {
	CPUUsagePercent    float64
	MemTotalMB         int64
	MemUsedMB          int64
	DiskTotalGB        int64
	DiskUsedGB         int64
	TimestampFormatted string
	Staleness          string
}

// DashboardProps holds data for the dashboard page.
type DashboardProps struct {
	Title     string
	Since     string
	Collectors []CollectorView
}

// cpuClass returns a CSS class based on CPU usage.
func cpuClass(percent float64) string {
	if percent > 80.0 {
		return "text-red-400"
	} else if percent > 60.0 {
		return "text-yellow-400"
	}
	return "text-fg-secondary"
}

// memPercent calculates memory usage percentage.
func memPercent(memUsed, memTotal int64) float64 {
	if memTotal <= 0 {
		return 0
	}
	return float64(memUsed) / float64(memTotal) * 100.0
}

// memClass returns a CSS class based on memory usage.
func memClass(percent float64) string {
	if percent > 80.0 {
		return "text-red-400"
	} else if percent > 60.0 {
		return "text-yellow-400"
	}
	return "text-fg-secondary"
}

// diskPercent calculates disk usage percentage.
func diskPercent(diskUsed, diskTotal int64) float64 {
	if diskTotal <= 0 {
		return 0
	}
	return float64(diskUsed) / float64(diskTotal) * 100.0
}

// diskClass returns a CSS class based on disk usage.
func diskClass(percent float64) string {
	if percent > 80.0 {
		return "text-red-400"
	} else if percent > 60.0 {
		return "text-yellow-400"
	}
	return "text-fg-secondary"
}

// Dashboard renders the dashboard page.
templ Dashboard(p DashboardProps) {
	@templates.Layout(p.Title, templates.NavData{Since: p.Since}) {
		<div class="max-w-5xl mx-auto p-2 md:p-6">
			<!-- Update Controls -->
			<div class="mb-6 flex gap-2 items-center">
				<button
					type="button"
					id="update-btn"
					hx-post="/panel/update"
					hx-target="#update-status"
					hx-swap="innerHTML"
					class="text-xs px-3 py-1.5 border border-bg-secondary rounded hover:bg-bg-secondary transition-colors"
				>
					Update Panel &amp; Collectors
				</button>
				<span id="update-status" class="text-xs text-fg-secondary"></span>
			</div>

			<!-- Update Progress Display -->
			<div id="update-progress" class="hidden mb-6">
				<div class="text-sm font-medium mb-2">Update Progress</div>
				<div id="progress-entities" class="space-y-2">
					<!-- Filled by JavaScript -->
				</div>
			</div>

			<div>
				if len(p.Collectors) == 0 {
					<div class="text-center text-fg-secondary py-12">
						<p>No collectors connected. Start a collector to begin receiving logs.</p>
					</div>
				}
				for _, c := range p.Collectors {
					<div class="mb-10">
						<!-- Collector Header -->
						<div class="mb-2">
							<a href={ "/panel/collectors/" + c.Name } class="text-xl font-semibold hover:opacity-80 transition-opacity">
								{ c.Name }
							</a>
						</div>

					@StatsRow(c.Stats, true, c.Name)

						<!-- Apps Grid -->
						<div
							hx-get={ "/panel/collectors/" + c.Name + "/apps" }
							hx-trigger="load"
							hx-swap="outerHTML"
						>
							<div class="text-fg-secondary text-sm">Loading apps...</div>
						</div>
					</div>
				}
			</div>
		</div>

		<script type="text/javascript">
			(function() {
				const progressContainer = document.getElementById('update-progress');
				const entitiesContainer = document.getElementById('progress-entities');
				const updateBtn = document.getElementById('update-btn');

				let eventSource = null;

				function renderEntities(entities) {
					if (!entities || entities.length === 0) {
						progressContainer.classList.add('hidden');
						return;
					}
					progressContainer.classList.remove('hidden');

					let html = '';
					for (const entity of entities) {
						const stagesHtml = entity.stages.map(s => {
							const statusIcon = s.status === 'done' ? '✓' :
								s.status === 'failed' ? '✗' :
								s.status === 'in_progress' ? '⟳' : '○';
							const statusColor = s.status === 'done' ? 'text-green-400' :
								s.status === 'failed' ? 'text-red-400' :
								s.status === 'in_progress' ? 'text-yellow-400' : 'text-fg-secondary';
							const message = s.message ? '<span class="text-fg-secondary ml-1">' + s.message + '</span>' : '';
							return '<div class="flex items-center gap-2 text-xs ' + statusColor + '">' +
								'<span>' + statusIcon + '</span>' +
								'<span class="font-mono">' + s.stage + '</span>' +
								message +
								'</div>';
						}).join('');

						html += '<div class="border border-bg-secondary rounded p-3">' +
							'<div class="text-sm font-medium mb-1">' + entity.entity + '</div>' +
							'<div class="space-y-0.5">' + stagesHtml + '</div>' +
							'</div>';
					}
					entitiesContainer.innerHTML = html;
				}

				function connectSSE() {
					if (eventSource) {
						eventSource.close();
					}

					eventSource = new EventSource('/panel/update/progress');

					eventSource.addEventListener('snapshot', function(e) {
						try {
							const entities = JSON.parse(e.data);
							renderEntities(entities);
						} catch (err) {
							console.error('Failed to parse progress snapshot:', err);
						}
					});

					eventSource.addEventListener('progress', function(e) {
						try {
							const data = JSON.parse(e.data);
							if (data.entities) {
								renderEntities(data.entities);
							}
						} catch (err) {
							console.error('Failed to parse progress event:', err);
						}
					});

					eventSource.onerror = function() {
						// SSE connection closed (expected when panel restarts)
						eventSource.close();
						eventSource = null;
						// Keep showing the last state
					};
				}

				// Listen for HTMX after-swap to detect update button click
				document.body.addEventListener('htmx:afterRequest', function(e) {
					if (e.detail.target && e.detail.target.id === 'update-status') {
						// Update was triggered, connect SSE
						connectSSE();
					}
				});

				// Cleanup on page unload
				window.addEventListener('beforeunload', function() {
					if (eventSource) {
						eventSource.close();
					}
				});
			})();
		</script>
	}
}
