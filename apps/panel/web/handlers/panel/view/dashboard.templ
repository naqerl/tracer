package view

import (
	"time"

	"tracer/apps/panel/web/templates"
)

// CollectorView represents a collector on the dashboard.
type CollectorView struct {
	Name               string
	RemoteAddr         string
	IsConnected        bool
	ConnectedAt        time.Time
	LastSeenAt         time.Time
	Stats              *CollectorStatsView
	AccessibleAppCount int
}

// CollectorStatsView represents collector resource stats.
type CollectorStatsView struct {
	CPUUsagePercent    float64
	MemTotalMB         int64
	MemUsedMB          int64
	DiskTotalGB        int64
	DiskUsedGB         int64
	TimestampFormatted string
	Staleness          string
}

// DashboardProps holds data for the dashboard page.
type DashboardProps struct {
	Title      string
	Since      string
	Collectors []CollectorView
}

// cpuClass returns a CSS class based on CPU usage.
func cpuClass(percent float64) string {
	if percent > 80.0 {
		return "text-red-400"
	} else if percent > 60.0 {
		return "text-yellow-400"
	}
	return "text-fg-secondary"
}

// memPercent calculates memory usage percentage.
func memPercent(memUsed, memTotal int64) float64 {
	if memTotal <= 0 {
		return 0
	}
	return float64(memUsed) / float64(memTotal) * 100.0
}

// memClass returns a CSS class based on memory usage.
func memClass(percent float64) string {
	if percent > 80.0 {
		return "text-red-400"
	} else if percent > 60.0 {
		return "text-yellow-400"
	}
	return "text-fg-secondary"
}

// diskPercent calculates disk usage percentage.
func diskPercent(diskUsed, diskTotal int64) float64 {
	if diskTotal <= 0 {
		return 0
	}
	return float64(diskUsed) / float64(diskTotal) * 100.0
}

// diskClass returns a CSS class based on disk usage.
func diskClass(percent float64) string {
	if percent > 80.0 {
		return "text-red-400"
	} else if percent > 60.0 {
		return "text-yellow-400"
	}
	return "text-fg-secondary"
}

// CollectorSectionProps configures the shared per-collector block rendered on
// the dashboard and the single-collector overview page.
type CollectorSectionProps struct {
	Name               string
	HeaderHref         string
	Stats              *CollectorStatsView
	AccessibleAppCount int
}

// CollectorSection renders a collector's header, stats row, and apps grid.
templ CollectorSection(props CollectorSectionProps) {
	<div class="mb-10">
		<div class="flex items-center">
			<div class="flex-1 min-w-0">
				<div class="flex items-center">
					if props.HeaderHref != "" {
						<a href={ props.HeaderHref } class="text-xl font-semibold hover:opacity-80 transition-opacity">
							{ props.Name }
						</a>
					} else {
						<h2 class="text-xl font-semibold">{ props.Name }</h2>
					}
					<div
						class="ml-2"
						hx-get={ "/panel/collectors/" + props.Name + "/last-update" }
						hx-trigger="load, every 15s"
						hx-swap="innerHTML"
					></div>
				</div>
				<!-- Stats Row -->
				<div
					hx-get={ "/panel/collectors/" + props.Name + "/stats" }
					hx-trigger="every 15s"
					hx-swap="innerHTML"
				>
					@StatsRow(props.Stats, props.Name)
				</div>
			</div>
			<a href={ "/panel/collectors/" + props.Name + "/apps/new" } class="ml-4 shrink-0 text-fg-secondary hover:text-fg transition-colors" aria-label="Add an app" title="Add an app">
				<img src="/static/img/plus.svg" alt="" class="w-5 h-5"/>
			</a>
		</div>
		<!-- Apps Grid -->
		<div
			hx-get={ "/panel/collectors/" + props.Name + "/apps" }
			hx-trigger="load, every 15s"
			hx-swap="innerHTML"
		>
			@CollectorAppsSkeleton(props.AccessibleAppCount)
		</div>
	</div>
}

// Dashboard renders the dashboard page.
templ Dashboard(p DashboardProps) {
	@templates.Layout(p.Title, templates.NavData{Since: p.Since}) {
		<div class="max-w-5xl mx-auto p-2 md:p-6">
			<div>
				if len(p.Collectors) == 0 {
					<div class="text-center text-fg-secondary py-12">
						<p>No collectors connected. Create a collector API key in <a href="/settings" class="text-fg underline">Settings</a> to get started.</p>
					</div>
				}
				for _, c := range p.Collectors {
					@CollectorSection(CollectorSectionProps{
						Name:               c.Name,
						HeaderHref:         "/panel/collectors/" + c.Name,
						Stats:              c.Stats,
						AccessibleAppCount: c.AccessibleAppCount,
					})
				}
			</div>
		</div>
	}
}
