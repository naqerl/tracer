package view

import (
	"fmt"

	"tracer/apps/panel/web/templates"
)

type AppProps struct {
	Title     string
	App       string
	Collector string
	Since     string
	Storage   AppStorageView
	Uptime    AppHealthView
	Level     string
}

// App renders the app detail page.
templ App(props AppProps) {
	@templates.Layout(props.App+" Analytics", templates.NavData{Since: props.Since}) {
		<div class="max-w-5xl mx-auto p-6">
			<div class="flex items-center justify-between mb-6">
				<a href={ "/panel/collectors/" + props.Collector } onclick="if (window.history.length > 1) { window.history.back(); return false; }" class="text-fg-secondary hover:text-fg text-sm">&lt; back</a>
				<div class="flex items-center gap-3">
					<a
						href={ "/panel/collectors/" + props.Collector + "/apps/" + props.App + "/settings" }
						class="text-sm text-fg-secondary hover:text-fg transition-colors"
						title="Configure app"
					>
						Settings
					</a>
				</div>
			</div>

			<div class="flex items-center gap-3 mb-6">
				<h1 class="text-3xl font-semibold">{ props.App }</h1>
				<div
					hx-get={ "/panel/collectors/" + props.Collector + "/apps/" + props.App + "/last-update" }
					hx-trigger="load, every 15s"
					hx-swap="innerHTML"
				></div>
			</div>

			@StoragePanel(props.Storage)

			<div
			  hx-get={ "/panel/collectors/" + props.Collector + "/apps/" + props.App + "/uptime" }
			  hx-trigger="every 15s"
			  hx-swap="innerHTML"
			>
				@UptimePanel(props.Uptime)
			</div>

			<div
			  hx-get={ "/panel/collectors/" + props.Collector + "/apps/" + props.App + "/stats" }
			  hx-trigger="load, every 15s"
			>
				@AppStatsSkeleton()
			</div>

			<div
			  hx-get={ "/panel/collectors/" + props.Collector + "/apps/" + props.App + "/logs/groups?level=" + props.Level }
			  hx-trigger="load"
			>
				<h2 class="text-lg font-medium mb-4">Log Groups</h2>
			</div>
		</div>
	}
}

// UptimePanel renders the uptime heading and bars as a pollable fragment. The
// uptime value carries the value-breath class so it brightens on each 15s
// refresh while the "Uptime" label stays static.
templ UptimePanel(uptime AppHealthView) {
	<h2 class="text-lg font-medium mb-4">Uptime <span class="value-breath">{ uptime.UptimeText }</span></h2>
	<div class="mb-6">
		@UptimeBars(uptime.Bars, "lg", "bars")
	</div>
}

// UptimeBars renders uptime visualizations. Units carrying the uptime-bar
// class animate their wave with a per-unit inline delay so one sweep crosses
// the whole row; units without health data stay static. The variant selects
// the shape: "bars" renders vertical columns sized by the size prop, "dots"
// renders fixed-size circles.
templ UptimeBars(bars []UptimeBarView, size string, variant string) {
	if len(bars) > 0 {
if variant == "dots" {
			<div class="flex items-center gap-0.5">
				for i, bar := range bars {
					<div class={ bar.Class + " box-border rounded-full aspect-square flex-1 min-w-0" }
						 style={ fmt.Sprintf("animation-delay: %.3fs", uptimeBarDelay(i, len(bars))) }
						 title={ bar.Title }
						 aria-label={ bar.Title }></div>
				}
			</div>
		} else if size == "sm" {
			<div class="flex items-end gap-1">
				for i, bar := range bars {
					<div class={ bar.Class + " box-border rounded-sm h-6 w-2" }
						 style={ fmt.Sprintf("animation-delay: %.3fs", uptimeBarDelay(i, len(bars))) }
						 title={ bar.Title }
						 aria-label={ bar.Title }></div>
				}
			</div>
		} else {
			<div class="flex items-end gap-px sm:gap-1">
				for i, bar := range bars {
					<div class={ bar.Class + " box-border rounded-sm h-8 sm:h-12 flex-1 min-w-1 sm:min-w-2" }
						 style={ fmt.Sprintf("animation-delay: %.3fs", uptimeBarDelay(i, len(bars))) }
						 title={ bar.Title }
						 aria-label={ bar.Title }></div>
				}
			</div>
		}
	} else {
		<div class="text-xs text-fg-secondary">No uptime samples in range</div>
	}
}
