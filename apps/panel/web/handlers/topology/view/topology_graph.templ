package view

import "tracer/apps/panel/web/templates"

type TopologyGraphProps struct {
	Title    string
	Snapshot string // JSON-serialized topology snapshot
}

templ TopologyGraph(p TopologyGraphProps) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			@templates.Head()
			<title>{ p.Title }</title>
		</head>
		<body>
			<div id="topology-graph-shell" data-snapshot={ p.Snapshot } class="flex min-h-[60vh] flex-1 items-center justify-center lg:min-h-0">
				<div class="w-full overflow-hidden">
					<svg id="topology-graph" class="block w-full max-w-full mx-auto" role="img" aria-label="Live topology graph"></svg>
				</div>
			</div>
			<script>
				(function() {
					const svg = document.getElementById('topology-graph');
					const graphShell = document.getElementById('topology-graph-shell');
					const eventLogEl = document.getElementById('topology-event-log');
					const dataEl = document.getElementById('topology-graph-shell');
					const animeFn = typeof window.anime === 'function' ? window.anime : null;

					if (!svg || !graphShell || !dataEl) {
						return;
					}

					const snapshot = JSON.parse(dataEl.dataset.snapshot);
					const MAX_PARTICLES = 60;
					const EVENT_THROTTLE_MS = 50;

					const state = {
						snapshot: snapshot,
						nodes: new Map(),
						edges: new Map(),
						viewport: null,
						nextActivityID: 1,
						logFlights: new Map(),
					};

					let isHidden = document.hidden;
					let activeParticles = 0;
					let animationFrameId = null;
					let lastEventTime = 0;
					const activeAnimations = new Set();
					const edgeFlashTimers = new Map();
					const eventBuffer = [];
					let eventFlushId = null;

					const NS = 'http://www.w3.org/2000/svg';
					const COLORS = {
						bg: '#0A0A0A',
						panelFill: '#1E1E1E',
						text: '#EEEEEE',
						muted: '#808080',
						accent: '#5C9CF5',
						secondary: '#F5A742',
						edge: '#808080',
						down: '#f87171',
						warn: '#facc15'
					};

					function el(name, attrs) {
						const node = document.createElementNS(NS, name);
						Object.entries(attrs || {}).forEach(([key, value]) => node.setAttribute(key, value));
						return node;
					}

					function layoutGraph() {
						const collectors = state.snapshot.collectors || [];
						let maxApps = 1;
						collectors.forEach((collector) => {
							maxApps = Math.max(maxApps, (collector.apps || []).length || 1);
						});

						const collectorCount = Math.max(collectors.length, 1);
						const collectorRadius = 190 + Math.max(collectorCount-4, 0) * 8;
						const appRadius = collectorRadius + 150 + Math.max(maxApps-3, 0) * 10;
						const outerNodeRadius = 36;
						const margin = 56;
						const size = Math.max(640, Math.ceil((appRadius + outerNodeRadius + margin) * 2));
						const centerX = size / 2;
						const centerY = size / 2;

						svg.setAttribute('viewBox', `0 0 ${size} ${size}`);
						svg.setAttribute('width', String(size));
						svg.setAttribute('height', String(size));
						svg.textContent = '';

						const defs = el('defs');
						const glow = el('filter', { id: 'topology-glow', x: '-50%', y: '-50%', width: '200%', height: '200%' });
						glow.appendChild(el('feGaussianBlur', { stdDeviation: '4', result: 'blur' }));
						glow.appendChild(el('feMerge'));
						defs.appendChild(glow);
						svg.appendChild(defs);

						const edgeLayer = el('g');
						const particleLayer = el('g');
						const nodeLayer = el('g');
						state.viewport = { edgeLayer, particleLayer, nodeLayer };
						svg.appendChild(edgeLayer);
						svg.appendChild(particleLayer);
						svg.appendChild(nodeLayer);

						state.nodes.clear();
						state.edges.clear();

						createPanelNode(nodeLayer, state.snapshot.panel, centerX, centerY);

						collectors.forEach((collector, index) => {
							const collectorAngle = (-Math.PI / 2) + (Math.PI * 2 * index / collectorCount);
							const collectorX = centerX + Math.cos(collectorAngle) * collectorRadius;
							const collectorY = centerY + Math.sin(collectorAngle) * collectorRadius;
							createCollectorNode(nodeLayer, collector, collectorX, collectorY, collectorAngle);
							createEdge(edgeLayer, particleLayer, `edge-panel-${collector.id}`, centerX, centerY, collectorX, collectorY, COLORS.edge, false);

							const apps = collector.apps || [];
							const span = Math.min(Math.PI / 2.4, (Math.PI * 1.5) / collectorCount);
							const divisor = Math.max(apps.length - 1, 1);
							apps.forEach((app, appIndex) => {
								const offset = apps.length === 1 ? 0 : ((appIndex / divisor) - 0.5) * span;
								const appAngle = collectorAngle + offset;
								const appX = centerX + Math.cos(appAngle) * appRadius;
								const appY = centerY + Math.sin(appAngle) * appRadius;
								createAppNode(nodeLayer, collector, app, appX, appY, appAngle);
								createEdge(edgeLayer, particleLayer, `edge-app-${collector.id}-${app.id}`, collectorX, collectorY, appX, appY, COLORS.edge, false);
							});
						});

						cropToContent();
					}

					function createPanelNode(layer, panel, x, y) {
						const group = el('g', { id: panel.id, transform: `translate(${x},${y})` });
						const body = el('circle', { cx: '0', cy: '0', r: '42', fill: COLORS.bg, stroke: COLORS.edge, 'stroke-width': '1.2', 'stroke-opacity': '0.28' });
						const kind = el('text', { x: '0', y: '1', 'text-anchor': 'middle', fill: COLORS.edge, 'fill-opacity': '0.68', 'font-size': 'clamp(11px, 1.1vw, 14px)', 'font-weight': '600', 'dominant-baseline': 'middle' });
						kind.textContent = 'panel';
						group.appendChild(body);
						group.appendChild(kind);
						addNodeHoverEffect(group);
						layer.appendChild(group);
						state.nodes.set(panel.id, { group, body, kind, baseStroke: COLORS.edge, baseFill: COLORS.bg, activities: new Map() });
					}

					function createCollectorNode(layer, collector, x, y, angle) {
						const group = el('g', { id: collector.id, transform: `translate(${x},${y})`, class: 'cursor-pointer' });
						const body = el('circle', { cx: '0', cy: '0', r: '40', fill: COLORS.bg, stroke: COLORS.edge, 'stroke-width': '1.2', 'stroke-opacity': '0.28' });
						const tagPos = radialTagPosition(angle, 58);
						const tag = createNodeTag(collector.name, tagPos.x, tagPos.y, textAnchorForAngle(angle));
						const kind = el('text', { x: '0', y: '1', 'text-anchor': 'middle', fill: COLORS.edge, 'fill-opacity': '0.68', 'font-size': 'clamp(10px, 1vw, 12px)', 'font-weight': '600', 'dominant-baseline': 'middle' });
						kind.textContent = 'collector';
						group.appendChild(body);
						group.appendChild(kind);
						group.appendChild(tag);
						addNodeHoverEffect(group);
						layer.appendChild(group);
						bindNodeNavigation(group, `/panel/collectors/${encodeURIComponent(collector.name)}`);
						const baseStroke = COLORS.edge;
						state.nodes.set(collector.id, { group, body, tag, kind, baseStroke, baseFill: COLORS.bg, activities: new Map() });
					}

					function createAppNode(layer, collector, app, x, y, angle) {
						const group = el('g', { id: app.id, transform: `translate(${x},${y})`, class: 'cursor-pointer' });
						const body = el('circle', { cx: '0', cy: '0', r: '28', fill: COLORS.bg, stroke: COLORS.edge, 'stroke-width': '1.2', 'stroke-opacity': '0.28' });
						const tagPos = radialTagPosition(angle, 48);
						const tag = createNodeTag(app.name, tagPos.x, tagPos.y, textAnchorForAngle(angle));
						const kind = el('text', { x: '0', y: '1', 'text-anchor': 'middle', fill: COLORS.edge, 'fill-opacity': '0.68', 'font-size': 'clamp(9px, 0.95vw, 11px)', 'font-weight': '600', 'dominant-baseline': 'middle' });
						kind.textContent = 'app';
						group.appendChild(body);
						group.appendChild(kind);
						group.appendChild(tag);
						addNodeHoverEffect(group);
						layer.appendChild(group);
						bindNodeNavigation(group, `/panel/collectors/${encodeURIComponent(collector.name)}/apps/${encodeURIComponent(app.name)}`);
						const baseStroke = COLORS.edge;
						state.nodes.set(app.id, { group, body, tag, kind, collectorID: collector.id, baseStroke, baseFill: COLORS.bg, activities: new Map() });
					}

					function addNodeHoverEffect(node) {
						const body = node.querySelector('circle');
						const kind = node.querySelector('text');
						const tag = node.querySelector('g');
						node.style.transition = 'opacity 150ms';
						if (body) {
							body.style.transition = 'stroke-opacity 150ms';
						}
						if (kind) {
							kind.style.transition = 'fill-opacity 150ms';
						}
						if (tag) {
							tag.style.transition = 'opacity 150ms';
						}
						node.addEventListener('mouseenter', function() {
							const graphNode = state.nodes.get(node.id);
							if (body && graphNode && graphNode.activities.size === 0) {
								body.setAttribute('stroke-opacity', '0.52');
							}
							if (kind) {
								kind.setAttribute('fill-opacity', '0.9');
							}
							if (tag) {
								tag.style.opacity = '1';
							}
						});
						node.addEventListener('mouseleave', function() {
							const graphNode = state.nodes.get(node.id);
							if (graphNode) {
								refreshNodeAppearance(graphNode);
							}
							if (kind) {
								kind.setAttribute('fill-opacity', '0.68');
							}
							if (tag) {
								tag.style.opacity = '';
							}
						});
					}

					function createNodeTag(text, x, y, anchor) {
						const group = el('g', { transform: `translate(${x},${y})` });
						const label = el('text', {
							x: '0',
							y: '0',
							'text-anchor': anchor,
							fill: COLORS.text,
							'font-size': 'clamp(11px, 1.05vw, 13px)',
							'font-weight': '600',
							'dominant-baseline': 'middle'
						});
						label.textContent = text;
						group.appendChild(label);
						return group;
					}

					function radialTagPosition(angle, distance) {
						return {
							x: Math.cos(angle) * distance,
							y: Math.sin(angle) * distance
						};
					}

					function textAnchorForAngle(angle) {
						const cosine = Math.cos(angle);
						if (cosine > 0.3) return 'start';
						if (cosine < -0.3) return 'end';
						return 'middle';
					}

					function bindNodeNavigation(node, href) {
						node.addEventListener('click', function() {
							window.location.href = href;
						});
						node.addEventListener('keydown', function(event) {
							if (event.key === 'Enter' || event.key === ' ') {
								event.preventDefault();
								window.location.href = href;
							}
						});
						node.setAttribute('tabindex', '0');
						node.setAttribute('role', 'link');
					}

					function createEdge(layer, particleLayer, id, x1, y1, x2, y2, color, dashed) {
						const midX = (x1 + x2) / 2;
						const midY = (y1 + y2) / 2;
						const vectorX = x2 - x1;
						const vectorY = y2 - y1;
						const norm = Math.max(Math.hypot(vectorX, vectorY), 1);
						const curve = Math.min(40, norm * 0.12);
						const direction = -1;
						const controlX = midX + direction * (vectorY / norm) * curve;
						const controlY = midY - direction * (vectorX / norm) * curve;
						const path = el('path', {
							id: id,
							d: `M ${x1} ${y1} Q ${controlX} ${controlY} ${x2} ${y2}`,
							fill: 'none',
							stroke: color,
							'stroke-width': '1.5',
							opacity: '0.28'
						});
						if (dashed) {
							path.setAttribute('stroke-dasharray', '4 6');
							path.setAttribute('opacity', '0.18');
						}
						layer.appendChild(path);
						state.edges.set(id, { path, particleLayer, dashed: Boolean(dashed) });
					}

					function cropToContent() {
						const margin = 28;
						let bounds;
						try {
							bounds = svg.getBBox();
						} catch (_) {
							return;
						}
						if (!bounds || bounds.width <= 0 || bounds.height <= 0) {
							return;
						}

						const x = Math.floor(bounds.x - margin);
						const y = Math.floor(bounds.y - margin);
						const width = Math.ceil(bounds.width + margin * 2);
						const height = Math.ceil(bounds.height + margin * 2);

						svg.setAttribute('viewBox', `${x} ${y} ${width} ${height}`);
						svg.setAttribute('width', String(width));
						svg.setAttribute('height', String(height));
						fitGraphToViewport(width, height);
					}

					function fitGraphToViewport(width, height) {
						const container = svg.parentElement;
						const containerWidth = container ? container.clientWidth : 0;
						const shellWidth = graphShell.clientWidth || containerWidth;
						const shellHeight = graphShell.clientHeight || 0;
						const viewportWidth = Math.max(320, window.innerWidth || width);
						const availableWidth = Math.max(240, shellWidth || (viewportWidth - 16));
						const availableHeight = shellHeight > 0 ? Math.max(240, shellHeight - 8) : 0;

						const scale = Math.min(availableWidth / width, availableHeight / height, 1);
						let renderedWidth = Math.round(width * scale);
						let renderedHeight = Math.round(height * scale);

						svg.style.width = `${renderedWidth}px`;
						svg.style.height = `${renderedHeight}px`;
						svg.style.marginLeft = 'auto';
						svg.style.marginRight = 'auto';
					}

					function tick(now) {
						if (activeAnimations.size === 0) {
							animationFrameId = null;
							return;
						}
						for (const anim of activeAnimations) {
							const elapsed = now - anim.startedAt;
							const progress = Math.min(elapsed / anim.duration, 1);
							anim.update(progress);
							if (progress >= 1) {
								activeAnimations.delete(anim);
								if (anim.onComplete) anim.onComplete();
							}
						}
						animationFrameId = requestAnimationFrame(tick);
					}

					function startLoop() {
						if (animationFrameId == null && activeAnimations.size > 0) {
							animationFrameId = requestAnimationFrame(tick);
						}
					}

					function scheduleFrame() {
						if (!isHidden) startLoop();
					}

					function onVisibilityChange() {
						isHidden = document.hidden;
						if (!isHidden) {
							flushEventBuffer();
							startLoop();
						}
					}

					function flashEdge(edge, color) {
						if (!edge) return;
						const path = edge.path;
						const existing = edgeFlashTimers.get(edge.path);
						if (existing) {
							if (existing.type === 'timeout') clearTimeout(existing.id);
							else activeAnimations.delete(existing.ref);
						}
						path.setAttribute('stroke', color);
						if (!animeFn) {
							path.setAttribute('opacity', '0.72');
							const id = window.setTimeout(function() {
								path.setAttribute('stroke', COLORS.edge);
								path.setAttribute('opacity', edge.dashed ? '0.18' : '0.28');
								edgeFlashTimers.delete(path);
							}, 320);
							edgeFlashTimers.set(path, { type: 'timeout', id: id });
							return;
						}
						const ref = {
							startedAt: performance.now(),
							duration: 560,
							update: function(p) {
								path.setAttribute('opacity', p < 0.25 ? String(0.28 + p / 0.25 * 0.44) : String(0.72 - ((p - 0.25) / 0.75) * (0.72 - (edge.dashed ? 0.18 : 0.28))));
							},
							onComplete: function() {
								path.setAttribute('stroke', COLORS.edge);
								edgeFlashTimers.delete(path);
							}
						};
						edgeFlashTimers.set(path, { type: 'anim', ref: ref });
						activeAnimations.add(ref);
						scheduleFrame();
					}

					function logFlightKey(evt) {
						return [
							evt.collector || '',
							evt.app || '',
							evt.level || '',
							evt.timestamp || ''
						].join('|');
					}

					function brightenColor(hex, amount) {
						const value = String(hex || '').replace('#', '');
						if (value.length !== 6) return hex;
						const ratio = Math.max(0, Math.min(1, amount));
						const channels = [0, 2, 4].map(function(offset) {
							const channel = parseInt(value.slice(offset, offset + 2), 16);
							if (!isFinite(channel)) return 0;
							return Math.round(channel + (255 - channel) * ratio);
						});
						return '#' + channels.map(function(channel) {
							return channel.toString(16).padStart(2, '0');
						}).join('');
					}

					function waveNode(node, delay, amount) {
						if (!node) return;
						const baseFill = node.baseFill || COLORS.panelFill;
						const activeFill = brightenColor(baseFill, amount || 0.16);
						const body = node.body;

						if (!animeFn) {
							const ref = {
								startedAt: performance.now() + (delay || 0),
								duration: 240,
								update: function(p) {
									body.setAttribute('fill', p < 0.5 ? activeFill : baseFill);
								},
								onComplete: function() {
									body.setAttribute('fill', baseFill);
								}
							};
							activeAnimations.add(ref);
							scheduleFrame();
							return;
						}

						const ref = {
							startedAt: performance.now() + (delay || 0),
							duration: 520,
							update: function(p) {
								if (p < 0.5) {
									const t = p * 2;
									body.setAttribute('fill', brightenColor(baseFill, (amount || 0.16) * t));
								} else {
									const t = (p - 0.5) * 2;
									body.setAttribute('fill', brightenColor(baseFill, (amount || 0.16) * (1 - t)));
								}
							},
							onComplete: function() {
								body.setAttribute('fill', baseFill);
							}
						};
						activeAnimations.add(ref);
						scheduleFrame();
					}

					function playHeartbeatWave() {
						const panelNode = state.nodes.get(state.snapshot.panel.id);
						waveNode(panelNode, 0, 0.22);

						const collectors = state.snapshot.collectors || [];
						collectors.forEach(function(collector, collectorIndex) {
							const collectorNode = state.nodes.get(collector.id);
							const collectorDelay = 120 + collectorIndex * 45;
							waveNode(collectorNode, collectorDelay, 0.18);

							(collector.apps || []).forEach(function(app, appIndex) {
								const appNode = state.nodes.get(app.id);
								const appDelay = collectorDelay + 120 + appIndex * 36;
								waveNode(appNode, appDelay, 0.14);
							});
						});
					}

					function refreshNodeAppearance(node) {
						if (!node) return;
						let activeColor = '';
						node.activities.forEach(function(color) {
							activeColor = color;
						});
						node.body.setAttribute('stroke', activeColor || node.baseStroke || COLORS.text);
						node.body.setAttribute('stroke-opacity', activeColor ? '0.88' : '0.28');
						node.body.setAttribute('stroke-width', activeColor ? '1.8' : '1.2');
					}

					function beginNodeActivity(node, color) {
						if (!node) return null;
						const id = state.nextActivityID++;
						node.activities.set(id, color);
						refreshNodeAppearance(node);
						return id;
					}

					function endNodeActivity(node, id) {
						if (!node || id == null) return;
						node.activities.delete(id);
						refreshNodeAppearance(node);
					}

					function sendParticle(edge, color, radius, reverse, shape, sourceNode, onComplete) {
						if (!edge || !edge.path) return;
						if (activeParticles >= MAX_PARTICLES) return;

						flashEdge(edge, color);

						const particle = createParticle(shape, color, radius || 4);
						edge.particleLayer.appendChild(particle);
						activeParticles++;
						const activityID = beginNodeActivity(sourceNode, color);

						const path = edge.path;
						const length = typeof path.getTotalLength === 'function' ? path.getTotalLength() : 1;

						function place(progress) {
							const clamped = Math.max(0, Math.min(1, progress));
							const distance = reverse ? length * (1 - clamped) : length * clamped;
							const point = path.getPointAtLength(distance);
							positionParticle(particle, point.x, point.y);
						}

						const duration = animeFn ? 720 : 700;

						function cleanup() {
							particle.remove();
							activeParticles--;
							endNodeActivity(sourceNode, activityID);
							if (typeof onComplete === 'function') onComplete();
						}

						if (isHidden) {
							particle.remove();
							activeParticles--;
							endNodeActivity(sourceNode, activityID);
							if (typeof onComplete === 'function') onComplete();
							return;
						}

						const ref = {
							startedAt: performance.now(),
							duration: duration,
							update: function(p) {
								place(p);
								particle.setAttribute('opacity', String(0.95 - p * 0.45));
							},
							onComplete: cleanup
						};
						activeAnimations.add(ref);
						scheduleFrame();
					}

					function createParticle(shape, color, size) {
						if (shape === 'triangle') {
							const halfWidth = size * 1.25;
							const height = size * 1.9;
							return el('polygon', {
								points: `0,${-height / 2} ${halfWidth},${height / 2} ${-halfWidth},${height / 2}`,
								fill: color,
								opacity: '0.95'
							});
						}
						if (shape === 'square') {
							return el('rect', {
								x: '0',
								y: '0',
								width: String(size * 2),
								height: String(size * 2),
								fill: color,
								opacity: '0.95'
							});
						}
						if (shape === 'rectangle') {
							return el('rect', {
								x: '0',
								y: '0',
								width: String(size * 3.6),
								height: String(size * 1.8),
								rx: '1.5',
								fill: color,
								opacity: '0.95'
							});
						}
						if (shape === 'diamond') {
							const diamondSize = size * 1.4;
							return el('polygon', {
								points: `0,${-diamondSize} ${diamondSize},0 0,${diamondSize} ${-diamondSize},0`,
								fill: color,
								opacity: '0.95'
							});
						}
						return el('circle', {
							cx: '0',
							cy: '0',
							r: String(size),
							fill: color,
							opacity: '0.95'
						});
					}

					function positionParticle(particle, x, y) {
						if (particle.tagName === 'polygon') {
							particle.setAttribute('transform', `translate(${x} ${y})`);
							return;
						}
						if (particle.tagName === 'rect') {
							const width = Number(particle.getAttribute('width')) || 0;
							const height = Number(particle.getAttribute('height')) || 0;
							particle.setAttribute('x', String(x - width / 2));
							particle.setAttribute('y', String(y - height / 2));
							return;
						}
						particle.setAttribute('cx', String(x));
						particle.setAttribute('cy', String(y));
					}

					function logLevelColor(level) {
						const normalized = String(level || '').toLowerCase();
						if (normalized === 'warn' || normalized === 'warning') return COLORS.secondary;
						if (normalized === 'error') return COLORS.down;
						return COLORS.accent;
					}

					function findCollectorByName(name) {
						return (state.snapshot.collectors || []).find((collector) => collector.name === name);
					}

					function findApp(collectorName, appName) {
						const collector = findCollectorByName(collectorName);
						if (!collector) return null;
						return (collector.apps || []).find((app) => app.name === appName);
					}

					function normalizeLogEvent(envelope) {
						const payload = envelope.data || {};
						const entry = payload.entry || {};
						return {
							collector: envelope.collector,
							app: payload.app,
							level: entry.level,
							timestamp: payload.timestamp || entry.timestamp || envelope.timestamp
						};
					}

					function normalizeStatsEvent(envelope) {
						const payload = envelope.data || {};
						const stats = payload.stats || payload.data || {};
						return {
							collector: envelope.collector,
							timestamp: payload.timestamp || stats.timestamp || envelope.timestamp,
							cpu_usage_percent: stats.cpu_usage_percent,
							mem_total_mb: stats.mem_total_mb,
							mem_used_mb: stats.mem_used_mb,
							disk_total_gb: stats.disk_total_gb,
							disk_used_gb: stats.disk_used_gb
						};
					}

					function normalizeHealthEvent(envelope) {
						const payload = envelope.data || {};
						return {
							collector: envelope.collector,
							app: payload.app,
							status: payload.status,
							timestamp: payload.timestamp || envelope.timestamp
						};
					}

					function eventColor(type, evt) {
						if (type === 'log_received' || type === 'log_persisted') return logLevelColor(evt.level);
						if (type === 'collector_stats') return COLORS.muted;
						if (type === 'app_health') return COLORS.muted;
						return COLORS.muted;
					}

					function eventMessage(type, evt) {
						if (type === 'log_received') return `${evt.app} -> ${evt.collector} log received`;
						if (type === 'log_persisted') return `${evt.collector} -> panel log persisted`;
						if (type === 'collector_stats') return `${evt.collector} stats updated`;
						if (type === 'app_health') return `${evt.collector} -> ${evt.app} health ${evt.status || 'unknown'}`;
						if (type === 'panel_tick') return 'panel heartbeat';
						if (type === 'collector_registered') return `${evt.collector} registered`;
						return type;
					}

					function eventShape(type) {
						if (type === 'collector_stats') return 'square';
						if (type === 'app_health') return 'triangle';
						if (type === 'panel_tick') return 'diamond';
						return 'circle';
					}

					function appendEventRow(type, evt) {
						if (!eventLogEl) return;

						const row = document.createElement('div');
						row.className = 'flex items-center gap-3 px-4 py-2 opacity-75';

						const dot = document.createElement('span');
						const shape = eventShape(type);
						dot.className = 'flex-none';
						if (shape === 'triangle') {
							dot.className += ' h-3 w-3';
							dot.style.clipPath = 'polygon(50% 0, 100% 100%, 0 100%)';
						} else if (shape === 'square') {
							dot.className += ' h-2.5 w-2.5';
						} else if (shape === 'rectangle') {
							dot.className += ' h-2 w-4 rounded-sm';
						} else if (shape === 'diamond') {
							dot.className += ' h-3 w-3';
							dot.style.clipPath = 'polygon(50% 0, 100% 50%, 50% 100%, 0 50%)';
						} else {
							dot.className += ' h-2.5 w-2.5 rounded-full';
						}
						dot.style.backgroundColor = eventColor(type, evt);

						const message = document.createElement('div');
						message.className = 'min-w-0 flex-1';

						const title = document.createElement('div');
						title.className = 'truncate';
						title.textContent = eventMessage(type, evt);

						const meta = document.createElement('div');
						meta.className = 'text-xs text-fg-secondary';
						meta.textContent = evt.timestamp ? new Date(evt.timestamp).toLocaleTimeString() : '';

						message.appendChild(title);
						message.appendChild(meta);
						row.appendChild(dot);
						row.appendChild(message);

						eventLogEl.prepend(row);
						while (eventLogEl.children.length > 100) {
							eventLogEl.removeChild(eventLogEl.lastElementChild);
						}
					}

					function throttledAppend(type, evt) {
						if (isHidden) {
							eventBuffer.push({ type: type, evt: evt });
							return;
						}
						const now = performance.now();
						if (now - lastEventTime < EVENT_THROTTLE_MS) {
							eventBuffer.push({ type: type, evt: evt });
							if (!eventFlushId) {
								eventFlushId = setTimeout(flushEventBuffer, EVENT_THROTTLE_MS);
							}
							return;
						}
						lastEventTime = now;
						appendEventRow(type, evt);
					}

					function flushEventBuffer() {
						eventFlushId = null;
						if (eventBuffer.length === 0) return;
						const batch = eventBuffer.splice(0, 20);
						for (const item of batch) {
							appendEventRow(item.type, item.evt);
						}
						lastEventTime = performance.now();
						if (eventBuffer.length > 0) {
							eventFlushId = setTimeout(flushEventBuffer, EVENT_THROTTLE_MS);
						}
					}

					function applyCollectorStats(evt) {
						throttledAppend('collector_stats', evt);
						const collector = findCollectorByName(evt.collector);
						if (!collector) return;
						const node = state.nodes.get(collector.id);
						sendParticle(state.edges.get(`edge-panel-${collector.id}`), COLORS.muted, 3.5, true, 'square', node);
					}

					function applyAppHealth(evt) {
						throttledAppend('app_health', evt);
						const collector = findCollectorByName(evt.collector);
						const app = findApp(evt.collector, evt.app);
						if (!collector || !app) return;
						if (app.has_health) {
							sendParticle(state.edges.get(`edge-app-${collector.id}-${app.id}`), COLORS.muted, 4, false, 'triangle', state.nodes.get(collector.id));
						}
					}

					function applyLogEvent(evt) {
						throttledAppend('log_received', evt);
						const collector = findCollectorByName(evt.collector);
						const app = findApp(evt.collector, evt.app);
						if (!collector || !app) return;
						const color = logLevelColor(evt.level);
						const key = logFlightKey(evt);
						const flight = {
							collectorID: collector.id,
							color: color,
							persisted: false
						};
						state.logFlights.set(key, flight);
						sendParticle(state.edges.get(`edge-app-${collector.id}-${app.id}`), color, 4, true, 'circle', state.nodes.get(app.id), function() {
							const current = state.logFlights.get(key);
							if (!current) return;
							if (current.persisted) {
								sendParticle(state.edges.get(`edge-panel-${current.collectorID}`), current.color, 4.5, true, 'circle', state.nodes.get(current.collectorID));
							}
							state.logFlights.delete(key);
						});
					}

					function applyPersistedLogEvent(evt) {
						throttledAppend('log_persisted', evt);
						const collector = findCollectorByName(evt.collector);
						if (!collector) return;
						const color = logLevelColor(evt.level);
						const key = logFlightKey(evt);
						const flight = state.logFlights.get(key);
						if (flight) {
							flight.persisted = true;
							return;
						}
						sendParticle(state.edges.get(`edge-panel-${collector.id}`), color, 4.5, true, 'circle', state.nodes.get(collector.id));
					}

					function panelTick(evt) {
						throttledAppend('panel_tick', evt);
						if (!isHidden) playHeartbeatWave();
					}

					layoutGraph();

					const eventSource = new EventSource('/topology/events');

					eventSource.addEventListener('register', function(event) {
						const payload = JSON.parse(event.data);
						throttledAppend('collector_registered', payload);
					});

					eventSource.addEventListener('log', function(event) {
						const payload = normalizeLogEvent(JSON.parse(event.data));
						applyLogEvent(payload);
					});

					eventSource.addEventListener('persisted', function(event) {
						const payload = normalizeLogEvent(JSON.parse(event.data));
						applyPersistedLogEvent(payload);
					});

					eventSource.addEventListener('health', function(event) {
						const payload = normalizeHealthEvent(JSON.parse(event.data));
						applyAppHealth(payload);
					});

					eventSource.addEventListener('stats', function(event) {
						const payload = normalizeStatsEvent(JSON.parse(event.data));
						applyCollectorStats(payload);
					});

					eventSource.addEventListener('tick', function(event) {
						const payload = JSON.parse(event.data);
						panelTick(payload);
					});

					window.addEventListener('beforeunload', function() {
						eventSource.close();
						if (animationFrameId != null) {
							cancelAnimationFrame(animationFrameId);
							animationFrameId = null;
						}
						if (eventFlushId != null) {
							clearTimeout(eventFlushId);
							eventFlushId = null;
						}
					});

					document.addEventListener('visibilitychange', onVisibilityChange);
				})();
			</script>
		</body>
	</html>
}
