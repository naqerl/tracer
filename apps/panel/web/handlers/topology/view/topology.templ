package view

import "tracer/apps/panel/web/templates"

type TopologyPageProps struct {
	Title string
	Nav   templates.NavData
}

templ TopologyPage(p TopologyPageProps) {
	@templates.Layout(p.Title, p.Nav) {
		<div class="h-[calc(100vh-3.5rem)] p-2 md:p-4">
			<section class="h-full">
				<div class="flex h-full flex-col gap-4 lg:flex-row">
					<div id="topology-graph-shell" hx-get="/topology/graph" hx-trigger="load" hx-swap="outerHTML" class="flex min-h-[60vh] flex-1 items-center justify-center lg:min-h-0">
						<div class="flex items-center justify-center w-full">
							<div class="animate-pulse text-fg-secondary">Loading topology graph...</div>
						</div>
					</div>
					<div class="flex h-48 flex-col border border-bg-secondary bg-bg-secondary/20 lg:h-full lg:w-72 lg:min-w-72 lg:flex-shrink-0">
						<div class="flex-none border-b border-bg-secondary px-4 py-2 text-xs uppercase tracking-[0.18em] text-fg-secondary">
							Event stream
						</div>
						<div id="topology-event-log" class="flex-1 min-h-0 overflow-auto divide-y divide-bg-secondary/60 text-sm"></div>
					</div>
				</div>
			</section>
		</div>
		<script>htmx.config.allowScriptTags = true;</script>
	}
}
