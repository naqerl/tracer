package templates

import "strconv"

// Head component renders the HTML head section
templ Head() {
	<meta charset="UTF-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
	<link rel="icon" type="image/svg+xml" href="/static/img/favicon.svg"/>
	<link rel="apple-touch-icon" href="/static/img/favicon.png"/>
	<link rel="preconnect" href="https://cdn.tailwindcss.com" crossorigin="crossorigin"/>
	<link rel="stylesheet" href="/static/uPlot.min.css"/>
	<link rel="stylesheet" href="/static/scrollbar.css"/>
	<link rel="stylesheet" href="/static/app.css"/>
	<script src="https://cdn.tailwindcss.com?plugins=forms"></script>
	<meta name="htmx-config" content='{"responseHandling":[{"code":"204","swap":false},{"code":"[23]..","swap":true},{"code":"422","swap":true},{"code":"[45]..","swap":false,"error":true},{"code":"...","swap":false}]}'/>
	<script src="/static/htmx.min.js"></script>
	<script src="/static/anime.umd.min.js" defer="defer"></script>
	<script src="/static/uPlot.iife.min.js" async="async"></script>
	<script type="text/javascript">
		tailwind.config = {
			theme: {
				extend: {
					colors: {
						bg: {
							DEFAULT: '#0A0A0A',
							secondary: '#1E1E1E',
						},
						fg: {
							DEFAULT: '#EEEEEE',
							secondary: '#808080',
						},
						accent: '#5C9CF5',
						secondary: '#F5A742',
					}
				}
			}
		}
	</script>
	<style type="text/tailwindcss">
		@layer base {
			body {
				@apply bg-bg text-fg font-sans antialiased;
			}
		}
	</style>
}

// Navbar renders the top navigation bar
templ Navbar(nav NavData) {
	<nav class="flex items-center justify-between px-4 py-3 border-b border-bg-secondary" aria-label="Main navigation">
		<div class="flex gap-3 sm:gap-6" id="nav-links">
			<a href="/panel/" class="text-sm font-medium hover:text-fg transition-colors" data-nav="panel">/panel</a>
			<a href="/topology/" class="text-sm font-medium hover:text-fg transition-colors" data-nav="topology">/topology</a>
			<a href="/settings/" class="text-sm font-medium hover:text-fg transition-colors" data-nav="settings">/settings</a>
		</div>
		<form class="flex items-center gap-1 text-sm" onsubmit="return false;">
			<div class="relative group" id="since-dropdown">
				<div class="flex items-center justify-between gap-1 px-2 py-1 border border-transparent group-hover:border-bg-secondary text-fg-secondary group-hover:text-fg transition-colors cursor-pointer w-[5.5rem]">
					<span class="flex items-center gap-1">
						<span>since</span>
						<span id="since-label">{ nav.Since }</span>
					</span>
					<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
				</div>
				<div id="since-options" class="hidden group-hover:block absolute left-0 right-0 top-full mt-0 bg-bg border-x border-b border-bg-secondary shadow-lg z-50">
					<button type="button" class="block w-full text-left px-2 py-1.5 text-sm hover:bg-bg-secondary transition-colors" onclick="navbarSelectSince('1h')">1h</button>
					<button type="button" class="block w-full text-left px-2 py-1.5 text-sm hover:bg-bg-secondary transition-colors" onclick="navbarSelectSince('6h')">6h</button>
					<button type="button" class="block w-full text-left px-2 py-1.5 text-sm hover:bg-bg-secondary transition-colors" onclick="navbarSelectSince('24h')">24h</button>
					<button type="button" class="block w-full text-left px-2 py-1.5 text-sm hover:bg-bg-secondary transition-colors" onclick="navbarSelectSince('7d')">7d</button>
					<button type="button" class="block w-full text-left px-2 py-1.5 text-sm hover:bg-bg-secondary transition-colors" onclick="navbarSelectSince('30d')">30d</button>
				</div>
			</div>
		</form>
		<script src="/static/navbar.js"></script>
	</nav>
}

// Layout wraps page content with HTML head, navbar, and scripts.
// Use as: @Layout(title, nav) { ... content ... }
templ Layout(title string, nav NavData) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			@Head()
			<title>{ title } - Tracer</title>
		</head>
		<body>
			@Navbar(nav)
			<main>
				{ children... }
			</main>
		</body>
	</html>
}

// ErrorPage renders an error page
templ ErrorPage(title string, message string, status int, nav NavData) {
	@Layout(title, nav) {
		<div class="max-w-5xl mx-auto p-6">
			<div class="mb-6">
				<h2 class="text-xl font-medium text-red-500">{ title }</h2>
			</div>
			<p class="text-fg-secondary">{ message }</p>
		</div>
	}
}

// Indicator renders an inline spinner with a message. It stays hidden until
// the triggering element references its id via hx-indicator.
templ Indicator(id, text string) {
	<span id={ id } class="htmx-indicator inline-flex items-center gap-1 ml-2 text-fg-secondary">
		<span class="inline-block w-3 h-3 rounded-full border-2 border-fg/30 border-t-accent animate-spin"></span>
		{ text }
	</span>
}

// Required renders a red asterisk marking a required field label.
templ Required() {
	<span class="text-red-500 ml-1" aria-hidden="true">*</span>
}

// FieldStatus renders a status message next to a field label. It stays hidden
// while empty and colors green/red based on ok. When oob is true the span is
// marked hx-swap-oob so response fragments can update it in place.
templ FieldStatus(id, text string, ok, oob bool) {
	<span id={ id } if oob { hx-swap-oob="true" } class={ tern(text == "", "hidden", "") + " ml-2" }>
		if text != "" {
			<span class={ "text-sm " + tern(ok, "text-green-500", "text-red-500") }>{ text }</span>
		}
	</span>
}

// MarkdownCheckbox renders an interactive markdown-style checkbox. The hidden
// input carries its value only when checked, so unchecked rows submit nothing.
templ MarkdownCheckbox(id string, name string, label string, value string, checked bool, indent int) {
	<div style={ "padding-left: " + strconv.Itoa(indent*24) + "px" }>
		<input type="hidden" name={ name } id={ id + "_value" } value={ tern(checked, value, "") } data-checked-value={ value }/>
		<button type="button" id={ id + "_toggle" } class={ "text-base transition-colors font-mono " + tern(checked, "text-fg", "text-fg-secondary hover:text-fg") } data-id={ id } data-action="toggle-checkbox" data-label={ label }>
			{ tern(checked, "[x] ", "[ ] ") + label }
		</button>
	</div>
}

// MarkdownCheckboxScript renders the JavaScript for markdown checkboxes. A
// window flag makes it idempotent so re-rendering a fragment (htmx swap) or
// including it from multiple components never double-wires the listener.
templ MarkdownCheckboxScript() {
	<script src="/static/markdown-checkbox.js"></script>
}

// JSONViewer renders a JSON object as a key-value grid
templ JSONViewer(data string, valid bool) {
	@templ.Raw(jsonViewerHTML(data, valid))
}

// JSONViewerFull renders a full JSON object as a key-value grid
templ JSONViewerFull(data string, valid bool) {
	@templ.Raw(jsonViewerFullHTML(data, valid))
}
