name = "demo-beta"
panel_endpoint = "ws://localhost:8080/ingest/ws/ingest"
api_key = "__API_KEY__"
stats_interval = "30s"
data_dir = "/demo/data"

[sources]
  [[sources.file]]
  id = "beta-json-file"
  path = "/demo/logs/beta-json.log"
  read_from = "end"

  [[sources.file]]
  id = "beta-regex-file"
  path = "/demo/logs/beta-regex.log"
  read_from = "end"

[parsers]
  [[parsers.json]]
  id = "json-beta"
  timestamp_field = "time"
  timestamp_format = "2006-01-02T15:04:05Z07:00"
  level_field = "severity"
  trace_id_field = "trace"
  message_field = "msg"

  [[parsers.regex]]
  id = "regex-beta"
  pattern = '^(?P<timestamp>[0-9T:+-]+)\|(?P<level>[A-Z]+)\|trace=(?P<trace_id>[^|]+)\|msg=(?P<message>[^|]+)\|channel=(?P<channel>[^|]+)\|target=(?P<target>[^|]+)\|attempt=(?P<attempt>[^|]+)$'
  timestamp_field = "timestamp"
  timestamp_format = "2006-01-02T15:04:05Z07:00"
  level_field = "level"
  trace_id_field = "trace_id"
  message_field = "message"

[[apps]]
name = "beta-json"
source_ref = "beta-json-file"
parser_ref = "json-beta"

[[apps]]
name = "beta-regex"
source_ref = "beta-regex-file"
parser_ref = "regex-beta"
