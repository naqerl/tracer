transport:
  name: demo-alpha
  panel_host: localhost:8080
  api_key: __API_KEY__

stats:
  stats_interval: 30s

parsers:
  json-default:
    type: json
    params:
      timestamp_field: timestamp
      timestamp_format: "2006-01-02T15:04:05Z07:00"
      level_field: level
      trace_id_field: trace_id
      message_field: message

  regex-default:
    type: regex
    params:
      pattern: '^(?P<timestamp>[^ ]+ [^ ]+) \[(?P<level>[A-Z]+)\] trace=(?P<trace_id>[^ ]+) msg="(?P<message>[^"]+)" user=(?P<user_id>[^ ]+) request=(?P<request_id>[^ ]+) amount=(?P<amount_usd>[^ ]+)$'
      timestamp_field: timestamp
      timestamp_format: "2006-01-02 15:04:05"
      level_field: level
      trace_id_field: trace_id
      message_field: message

apps:
  - name: alpha-json
    parser_id: json-default
    health:
      type: http
      params:
        url: http://127.0.0.1:8083/health/alpha-json
        interval: 15s
        timeout: 3s
        expected_status: "200"
    lifecycle:
      start_pattern: SERVICE_LIFECYCLE start
      restart_pattern: SERVICE_LIFECYCLE restart
      exit_pattern: SERVICE_LIFECYCLE exit
    source:
      type: file
      params:
        path: /demo/logs/alpha-json.log
        read_from: end

  - name: alpha-regex
    parser_id: regex-default
    health:
      type: http
      params:
        url: http://127.0.0.1:8083/health/alpha-regex
        interval: 15s
        timeout: 3s
        expected_status: "200"
    lifecycle:
      start_pattern: SERVICE_LIFECYCLE start
      restart_pattern: SERVICE_LIFECYCLE restart
      exit_pattern: SERVICE_LIFECYCLE exit
    source:
      type: file
      params:
        path: /demo/logs/alpha-regex.log
        read_from: end
