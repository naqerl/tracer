FROM docker.io/library/golang:1.25-bookworm AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG LDFLAGS=-s\ -w\ -X\ tracer/pkg/setup.WithSystemd=yes

RUN CGO_ENABLED=0 go build -ldflags="${LDFLAGS}" -o /out/tracer-panel ./apps/panel/cmd/tracer-panel
RUN CGO_ENABLED=0 go build -ldflags="${LDFLAGS}" -o /out/tracer-collector ./apps/collector/cmd/tracer-collector
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /out/tracer-demo-loggen ./e2e/mocklog/main.go

FROM docker.io/library/debian:bookworm

ENV container=podman

RUN apt-get update && apt-get install -y --no-install-recommends \
    systemd \
    systemd-sysv \
    ca-certificates \
    curl \
    tar \
    passwd \
    procps \
    iproute2 \
    bash \
    git \
    make && \
    rm -rf /var/lib/apt/lists/*

RUN curl -fsSL -o /tmp/caddy.tar.gz \
    https://github.com/caddyserver/caddy/releases/download/v2.9.1/caddy_2.9.1_linux_amd64.tar.gz && \
    tar -xzf /tmp/caddy.tar.gz -C /usr/local/bin caddy && \
    chmod 0755 /usr/local/bin/caddy && \
    rm /tmp/caddy.tar.gz

COPY --from=build /out/tracer-panel /usr/local/bin/tracer-panel
COPY --from=build /out/tracer-collector /usr/local/bin/tracer-collector
COPY --from=build /out/tracer-demo-loggen /usr/local/bin/tracer-demo-loggen
COPY e2e/install-on-boot.sh /opt/tracer/e2e/install-on-boot.sh
COPY e2e/systemd/ /etc/systemd/system/
COPY e2e/Caddyfile /etc/caddy/Caddyfile

RUN chmod 0755 /opt/tracer/e2e/install-on-boot.sh /usr/local/bin/tracer-demo-loggen && \
    mkdir -p /etc/systemd/system/multi-user.target.wants /opt/tracer/landing/html && \
    ln -sf /etc/systemd/system/caddy.service /etc/systemd/system/multi-user.target.wants/caddy.service && \
    ln -sf /etc/systemd/system/install-on-boot.service /etc/systemd/system/multi-user.target.wants/install-on-boot.service && \
    ln -sf /etc/systemd/system/demo-api.service /etc/systemd/system/multi-user.target.wants/demo-api.service && \
    ln -sf /etc/systemd/system/demo-worker.service /etc/systemd/system/multi-user.target.wants/demo-worker.service && \
    ln -sf /etc/systemd/system/demo-cron.service /etc/systemd/system/multi-user.target.wants/demo-cron.service

STOPSIGNAL SIGRTMIN+3
EXPOSE 8080
CMD ["/lib/systemd/systemd"]
