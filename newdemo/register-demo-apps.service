[Unit]
Description=Register New Demo apps in Tracer collector
After=newdemo-install.service tracer-demo-api.service tracer-demo-worker.service tracer-demo-cron.service
Wants=tracer-demo-api.service tracer-demo-worker.service tracer-demo-cron.service
Requires=newdemo-install.service

[Service]
Type=oneshot
ExecStart=/opt/tracer/newdemo/register-demo-apps.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
