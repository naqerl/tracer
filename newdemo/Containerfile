FROM docker.io/library/golang:1.25-bookworm AS build

WORKDIR /src
COPY . .
RUN make build

FROM docker.io/library/debian:bookworm

ENV container=podman

RUN apt-get update && apt-get install -y --no-install-recommends \
    systemd \
    systemd-sysv \
    ca-certificates \
    curl \
    tar \
    passwd \
    procps \
    iproute2 \
    bash && \
    rm -rf /var/lib/apt/lists/*

COPY --from=build /src/bin /opt/tracer-bin
COPY install.sh /opt/tracer/install.sh
COPY newdemo/install-on-boot.sh /opt/tracer/newdemo/install-on-boot.sh
COPY newdemo/install-on-boot.service /etc/systemd/system/newdemo-install.service

RUN chmod 0755 /opt/tracer/install.sh /opt/tracer/newdemo/install-on-boot.sh && \
    mkdir -p /etc/systemd/system/multi-user.target.wants && \
    ln -sf /etc/systemd/system/newdemo-install.service /etc/systemd/system/multi-user.target.wants/newdemo-install.service

STOPSIGNAL SIGRTMIN+3
EXPOSE 8080
CMD ["/lib/systemd/systemd"]
