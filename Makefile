# Build configuration (overridable via environment)
WITH_SYSTEMD ?= auto
BINDIR ?= /usr/local/bin
PANEL_USER ?= tracer-panel
COLLECTOR_USER ?= tracer-collector
TRACER_GROUP ?= tracer
CGO_ENABLED ?= 0

# Container registry (Forgejo) — format: {registry}/{owner}/{image}
REGISTRY ?= git.naqerl.com
OWNER   ?= naqerl
IMAGE_PANEL  ?= $(REGISTRY)/$(OWNER)/panel
IMAGE_DEMO   ?= $(REGISTRY)/$(OWNER)/tracer-demo

# Build version (set VERSION env var to inject, e.g. `make build VERSION=v1.2.3`).
# Derives from git when unset (CI passes github.ref_name via VERSION).
VERSION ?= $(shell git describe --tags --always --dirty 2>/dev/null || echo "unknown")

LDFLAGS := -s -w \
	-X tracer/build.Commit=$(VERSION) \
	-X tracer/build.Ref=$(VERSION) \
	-X tracer/build.WithSystemd=$(WITH_SYSTEMD) \
	-X tracer/build.Bindir=$(BINDIR) \
	-X tracer/build.PanelUser=$(PANEL_USER) \
	-X tracer/build.CollectorUser=$(COLLECTOR_USER) \
	-X tracer/build.TracerGroup=$(TRACER_GROUP) \
	-X tracer/apps/panel.Version=$(VERSION) \
	-X tracer/apps/collector.Version=$(VERSION)

.PHONY: build build-collector build-panel checksums clean test vet dev-setup generate sqlc install favicon \
	docker-build-panel docker-tag-panel docker-push-panel \
	docker-build-demo docker-tag-demo docker-push-demo

build: checksums

# Checksums are generated by overwriting (not appending) so the file always
# holds exactly one entry per binary. Entries keep the "bin/" prefix because
# install.sh downloads into $TMPDIR/bin and greps for "bin/<name>".
checksums: build-collector build-panel
	sha256sum bin/tracer-collector bin/tracer-panel > bin/checksums.txt

build-collector:
	go build -ldflags="$(LDFLAGS)" -o bin/tracer-collector ./apps/collector/cmd/tracer-collector

build-panel:
	go build -ldflags="$(LDFLAGS)" -o bin/tracer-panel ./apps/panel/cmd/tracer-panel
clean:
	rm -rf bin/

test: vet
	go test ./...

vet: generate
	go fmt ./...
	go vet ./...
	go tool staticcheck ./...

dev-setup:
	go install github.com/sqlc-dev/sqlc/cmd/sqlc@v1.31.1
	go mod download
	go mod tidy

generate:
	go tool templ generate

# Regenerate the panel favicon assets from ./scripts/gen-favicon. The favicon.svg
# is produced by the generator (it is not hand-edited); the apple-touch-icon PNG
# is rasterized from it with librsvg. Run after changing the geometry in
# scripts/gen-favicon/main.go.
favicon:
	go run ./scripts/gen-favicon
	rsvg-convert -w 180 -h 180 -o apps/panel/web/static/static/img/favicon.png apps/panel/web/static/static/img/favicon.svg

sqlc:
	cd apps/panel && sqlc generate

install: build
	@echo "Installing binaries to $(BINDIR)..."
	@install -d $(BINDIR)
	@install -m 0755 bin/tracer-collector $(BINDIR)/
	@install -m 0755 bin/tracer-panel $(BINDIR)/
	@echo "Installed: $(BINDIR)/tracer-collector"
	@echo "Installed: $(BINDIR)/tracer-panel"
	@echo ""
	@echo "Setting up tracer-collector..."
	@tracer-collector install
	@echo ""
	@echo "Setting up tracer-panel..."
	@tracer-panel install
	@echo ""
	@echo "Initializing panel..."
	@api_key=$$(tracer-panel -init 2>/dev/null | grep '^collector_api_key=' | cut -d= -f2); \
	if [ -n "$$api_key" ]; then \
		echo "Configuring collector with API key..."; \
		tracer-collector set api-key "$$api_key"; \
	else \
		echo "Panel already initialized, skipping API key setup"; \
	fi
	@echo ""
	@echo "========================================"
	@echo "Installation complete!"
	@echo "========================================"
	@echo ""
	@echo "Start services with:"
	@echo "  sudo systemctl start tracer-collector"
	@echo "  sudo systemctl start tracer-panel"

# ── Container images ──────────────────────────────────────────────────────────
# Build the panel image using the multi-stage Dockerfile.
docker-build-panel:
	docker build \
		-t $(IMAGE_PANEL):latest \
		-f apps/panel/Dockerfile \
		.

# Tag the panel image with a specific version (usage: make docker-tag-panel TAG=v1.2.3).
docker-tag-panel:
ifndef TAG
	$(error TAG is required. Usage: make docker-tag-panel TAG=v1.2.3)
endif
	docker tag $(IMAGE_PANEL):latest $(IMAGE_PANEL):$(TAG)

# Push all tags of the panel image to the registry.
docker-push-panel:
	docker push $(IMAGE_PANEL):latest
ifneq ($(TAG),)
	docker push $(IMAGE_PANEL):$(TAG)
endif

# ── Demo / E2E container image ─────────────────────────────────────────────────
docker-build-demo:
	docker build \
		-t $(IMAGE_DEMO):latest \
		-f e2e/Dockerfile \
		.

docker-tag-demo:
ifndef TAG
	$(error TAG is required. Usage: make docker-tag-demo TAG=v1.2.3)
endif
	docker tag $(IMAGE_DEMO):latest $(IMAGE_DEMO):$(TAG)

docker-push-demo:
	docker push $(IMAGE_DEMO):latest
ifneq ($(TAG),)
	docker push $(IMAGE_DEMO):$(TAG)
endif
