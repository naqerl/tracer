#!/bin/bash
#
# Tracer Configure & Install Script
# ====================================
#
# This script handles both development configuration (generating build/config.mk)
# and production installation (downloading/building binaries and setting up services).
#
# Usage:
#   ./configure                     Interactive installation wizard
#   ./configure --help              Show this help
#
# For development (just generate build/config.mk):
#   ./configure --make-config
#
# For automated installation:
#   ./configure --prefix=/usr/local --bindir=/usr/local/bin \
#               --panel-host=0.0.0.0 --panel-port=8080 \
#               --admin-username=admin --admin-password=secret
#
# Environment variables can be used instead of flags:
#   TRACER_PREFIX, TRACER_BINDIR, TRACER_SYSCONFDIR, TRACER_LOCALSTATEDIR,
#   TRACER_WITH_SYSTEMD, TRACER_WITH_PANEL,
#   TRACER_PANEL_HOST, TRACER_PANEL_PORT, TRACER_COLLECTOR_API_KEY,
#   TRACER_ADMIN_USERNAME, TRACER_ADMIN_PASSWORD,
#   TRACER_DOWNLOAD_URL (base URL for pre-built binaries)
#
set -euo pipefail

# ---- Defaults ----
PREFIX="${TRACER_PREFIX:-/usr/local}"
BINDIR="${TRACER_BINDIR:-$PREFIX/bin}"
SYSCONFDIR="${TRACER_SYSCONFDIR:-/etc}"
LOCALSTATEDIR="${TRACER_LOCALSTATEDIR:-/var}"
WITH_SYSTEMD="${TRACER_WITH_SYSTEMD:-auto}"
WITH_PANEL="${TRACER_WITH_PANEL:-yes}"
PANEL_HOST="${TRACER_PANEL_HOST:-0.0.0.0}"
PANEL_PORT="${TRACER_PANEL_PORT:-8080}"
COLLECTOR_API_KEY="${TRACER_COLLECTOR_API_KEY:-}"
ADMIN_USERNAME="${TRACER_ADMIN_USERNAME:-}"
ADMIN_PASSWORD="${TRACER_ADMIN_PASSWORD:-}"
DOWNLOAD_URL="${TRACER_DOWNLOAD_URL:-}"
GO_MIN_VERSION="1.23.0"

# ---- Modes ----
MODE="${TRACER_MODE:-install}"  # "install" or "make-config"
FORCE_BUILD=false
FORCE_DOWNLOAD=false

# ---- Colors ----
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

# ---- Logging ----
log_info()  { echo -e "${GREEN}[INFO]${NC} $1"; }
log_warn()  { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }
log_step()  { echo -e "${CYAN}──${NC} $1"; }

# ---- Help ----
show_help() {
    cat <<'EOF'
Tracer Configure & Install Script

Usage:
  ./configure [options]

Options:
  # Operation mode
  --make-config          Only generate build/config.mk for development
  --build                Force building from source
  --download             Force downloading pre-built binaries (if available)

  # Installation paths
  --prefix=PATH          Installation prefix (default: /usr/local)
  --bindir=PATH          Binary installation directory (default: PREFIX/bin)
  --sysconfdir=PATH      Configuration directory (default: /etc)
  --localstatedir=PATH   Data directory (default: /var)

  # Features
  --with-systemd=yes|no|auto  Enable/disable systemd support (default: auto)
  --with-panel=yes|no         Include panel (default: yes)

  # Panel configuration
  --panel-host=HOST       Panel listen address (default: 0.0.0.0)
  --panel-port=PORT       Panel listen port (default: 8080)
  --admin-username=USER   Admin username (interactive if not set)
  --admin-password=PASS   Admin password (auto-generated if not set)

  # Collector configuration
  --collector-api-key=KEY Collector API key for panel auth

  # General
  --help, -h              Show this help message

Environment variables:
  All options can be set via environment variables with TRACER_ prefix:
  TRACER_PREFIX, TRACER_BINDIR, TRACER_SYSCONFDIR, TRACER_LOCALSTATEDIR,
  TRACER_WITH_SYSTEMD, TRACER_WITH_PANEL,
  TRACER_PANEL_HOST, TRACER_PANEL_PORT,
  TRACER_COLLECTOR_API_KEY,
  TRACER_ADMIN_USERNAME, TRACER_ADMIN_PASSWORD,
  TRACER_DOWNLOAD_URL (base URL for binary downloads)
EOF
    exit 0
}

# ---- Parse arguments ----
parse_args() {
    while [[ $# -gt 0 ]]; do
        case $1 in
            --make-config)        MODE="make-config"; shift ;;
            --build)              FORCE_BUILD=true; shift ;;
            --download)           FORCE_DOWNLOAD=true; shift ;;
            --prefix=*)           PREFIX="${1#*=}"; shift ;;
            --bindir=*)           BINDIR="${1#*=}"; shift ;;
            --sysconfdir=*)       SYSCONFDIR="${1#*=}"; shift ;;
            --localstatedir=*)    LOCALSTATEDIR="${1#*=}"; shift ;;
            --with-systemd=yes)   WITH_SYSTEMD="yes"; shift ;;
            --with-systemd=no)    WITH_SYSTEMD="no"; shift ;;
            --with-systemd=auto)  WITH_SYSTEMD="auto"; shift ;;
            --with-systemd=*)     log_error "Invalid value for --with-systemd: ${1#*=}. Must be yes, no, or auto"; exit 1 ;;
            --without-systemd)    WITH_SYSTEMD="no"; shift ;;
            --with-panel=yes)     WITH_PANEL="yes"; shift ;;
            --with-panel=no)      WITH_PANEL="no"; shift ;;
            --with-panel=*)       log_error "Invalid value for --with-panel: ${1#*=}. Must be yes or no"; exit 1 ;;
            --without-panel)      WITH_PANEL="no"; shift ;;
            --panel-host=*)       PANEL_HOST="${1#*=}"; shift ;;
            --panel-port=*)       PANEL_PORT="${1#*=}"; shift ;;
            --admin-username=*)   ADMIN_USERNAME="${1#*=}"; shift ;;
            --admin-password=*)   ADMIN_PASSWORD="${1#*=}"; shift ;;
            --collector-api-key=*) COLLECTOR_API_KEY="${1#*=}"; shift ;;
            --help|-h)            show_help ;;
            *)                    log_error "Unknown option: $1"; exit 1 ;;
        esac
    done

    # Update BINDIR if PREFIX changed but BINDIR wasn't explicitly set
    if [[ -z "${TRACER_BINDIR:-}" && "$PREFIX" != "/usr/local" && "$BINDIR" == "/usr/local/bin" ]]; then
        BINDIR="$PREFIX/bin"
    fi

    # Auto-mode: if no install-specific flags, default to make-config
    if [[ "$MODE" != "make-config" ]]; then
        local install_flags=0
        [[ "$FORCE_BUILD" == "true" ]] && install_flags=$((install_flags + 1))
        [[ "$FORCE_DOWNLOAD" == "true" ]] && install_flags=$((install_flags + 1))
        [[ -n "$ADMIN_USERNAME" ]] && install_flags=$((install_flags + 1))
        [[ -n "$COLLECTOR_API_KEY" ]] && install_flags=$((install_flags + 1))

        if [[ "$install_flags" -eq 0 && -f Makefile && -d apps ]]; then
            MODE="make-config"
        fi
    fi
}

# ---- Utility functions ----
version_ge() {
    printf '%s\n%s\n' "$2" "$1" | sort -V -C
}

detect_arch() {
    local arch
    arch=$(uname -m)
    case "$arch" in
        x86_64)  echo "amd64" ;;
        aarch64|arm64) echo "arm64" ;;
        *) log_error "Unsupported architecture: $arch"; exit 1 ;;
    esac
}

detect_os() {
    case "$(uname -s)" in
        Linux)  echo "linux" ;;
        Darwin) echo "darwin" ;;
        *)      log_error "Unsupported OS: $(uname -s)"; exit 1 ;;
    esac
}

check_go() {
    if ! command -v go &>/dev/null; then
        log_warn "Go is not installed"
        return 1
    fi
    local current_version
    current_version=$(go version | grep -oE '[0-9]+\.[0-9]+(\.[0-9]+)?' | head -1)
    if [[ -z "$current_version" ]]; then
        return 1
    fi
    if version_ge "$current_version" "$GO_MIN_VERSION"; then
        log_info "Found Go $current_version"
        return 0
    fi
    log_warn "Go $current_version found, but $GO_MIN_VERSION+ required"
    return 1
}

check_root() {
    if [[ $EUID -ne 0 ]]; then
        log_error "This script must be run as root (use sudo)"
        exit 1
    fi
}

prompt() {
    local prompt_text="$1"
    local default="${2:-}"
    local var_name="$3"
    local input

    if [[ -n "$default" ]]; then
        prompt_text="$prompt_text [$default]"
    fi

    read -r -p "$prompt_text: " input
    input="${input:-$default}"
    printf -v "$var_name" "%s" "$input"
}

prompt_yesno() {
    local prompt_text="$1"
    local default="${2:-y}"
    local var_name="$3"
    local input

    if [[ "$default" == "y" ]]; then
        prompt_text="$prompt_text [Y/n]"
    else
        prompt_text="$prompt_text [y/N]"
    fi

    read -r -p "$prompt_text: " input
    input="${input:-$default}"
    case "$input" in
        [Yy]|[Yy][Ee][Ss]) printf -v "$var_name" "yes" ;;
        [Nn]|[Nn][Oo])     printf -v "$var_name" "no" ;;
        *)                 printf -v "$var_name" "$default" ;;
    esac
}

# ---- Build/config.mk generation (for development) ----
generate_make_config() {
    log_info "Generating build/config.mk for development..."

    # Resolve systemd
    local systemd_val="$WITH_SYSTEMD"
    if [[ "$systemd_val" == "auto" ]]; then
        if command -v systemctl &>/dev/null && [[ -d /run/systemd ]]; then
            systemd_val="yes"
        else
            systemd_val="no"
        fi
    fi

    mkdir -p build
    cat > build/config.mk <<EOF
# Generated by configure (development mode)
PREFIX = $PREFIX
BINDIR = $BINDIR
SYSCONFDIR = $SYSCONFDIR
LOCALSTATEDIR = $LOCALSTATEDIR
WITH_SYSTEMD = $systemd_val
WITH_PANEL = $WITH_PANEL
GO = go
GOFLAGS = -trimpath
LDFLAGS = -s -w
CGO_ENABLED = 0
COLLECTOR_SRC = ./apps/collector/cmd/tracer-collector/main.go
PANEL_SRC = ./apps/panel/cmd/tracer-panel/main.go
BUILD_DIR = ./build
TRACER_GROUP = tracer
COLLECTOR_USER = tracer-collector
PANEL_USER = tracer-panel
EOF
    log_info "Written build/config.mk"

    echo ""
    echo "========================================"
    echo "Configuration Summary"
    echo "========================================"
    echo ""
    echo "Installation paths:"
    echo "  prefix:        $PREFIX"
    echo "  bindir:        $BINDIR"
    echo "  sysconfdir:    $SYSCONFDIR"
    echo "  localstatedir: $LOCALSTATEDIR"
    echo ""
    echo "Options:"
    echo "  systemd:       $systemd_val"
    echo "  panel:         $WITH_PANEL"
    echo "  tracer group:  tracer"
    echo "  panel user:    tracer-panel"
    echo "  collector user: tracer-collector"
    echo ""
    echo "Type 'make' to build, 'sudo make install' to install."
    echo ""
}

# ---- Build from source ----
build_from_source() {
    local src_dir="$1"

    log_info "Building from source in $src_dir"

    # Check Go availability
    if ! check_go; then
        log_error "Cannot build from source: Go $GO_MIN_VERSION+ is required."
        log_error "Install Go from https://go.dev/dl/ or use --download to get pre-built binaries."
        exit 1
    fi

    cd "$src_dir"

    # Ensure we have a config.mk for the Makefile
    if [[ ! -f build/config.mk ]]; then
        mkdir -p build
        cat > build/config.mk <<EOF
PREFIX = $PREFIX
BINDIR = $BINDIR
SYSCONFDIR = $SYSCONFDIR
LOCALSTATEDIR = $LOCALSTATEDIR
WITH_SYSTEMD = yes
WITH_PANEL = $WITH_PANEL
GO = go
GOFLAGS = -trimpath
LDFLAGS = -s -w
CGO_ENABLED = 0
COLLECTOR_SRC = ./apps/collector/cmd/tracer-collector/main.go
PANEL_SRC = ./apps/panel/cmd/tracer-panel/main.go
BUILD_DIR = ./build
TRACER_GROUP = tracer
COLLECTOR_USER = tracer-collector
PANEL_USER = tracer-panel
EOF
    fi

    log_step "Running make build..."
    make build

    log_step "Copying binaries..."
    mkdir -p "$BINDIR"
    cp bin/tracer-collector "$BINDIR/"
    cp bin/tracer-panel "$BINDIR/"

    log_info "Binaries built and copied to $BINDIR"
}

# ---- Download pre-built binaries ----
build_download() {
    local dest_dir="$1"

    if [[ -z "$DOWNLOAD_URL" ]]; then
        log_warn "No DOWNLOAD_URL configured for pre-built binaries."
        log_warn "Falling back to building from source."
        return 1
    fi

    local os_name
    local arch_name
    os_name=$(detect_os)
    arch_name=$(detect_arch)

    local download_base="${DOWNLOAD_URL}/${os_name}/${arch_name}"

    log_info "Downloading binaries from $download_base"

    mkdir -p "$dest_dir/bin"

    for binary in tracer-collector tracer-panel; do
        local url="${download_base}/${binary}"
        log_step "Downloading $binary..."
        if ! curl -fsSL "$url" -o "$dest_dir/bin/$binary"; then
            log_error "Failed to download $binary from $url"
            return 1
        fi
        chmod +x "$dest_dir/bin/$binary"
    done

    # Copy to final BINDIR
    mkdir -p "$BINDIR"
    cp "$dest_dir/bin"/* "$BINDIR/"
    log_info "Binaries downloaded and copied to $BINDIR"
    return 0
}

# ---- Interactive setup wizard ----
interactive_setup() {
    echo ""
    echo "=========================================="
    echo "   Tracer Setup Wizard"
    echo "=========================================="
    echo ""

    # Installation mode
    echo "How would you like to obtain the binaries?"
    echo "  1) Download pre-built binaries (if available)"
    echo "  2) Build from source (requires Go $GO_MIN_VERSION+)"
    echo ""
    local choice
    read -r -p "Select [1/2] (default: 1): " choice
    choice="${choice:-1}"
    if [[ "$choice" == "2" ]]; then
        FORCE_BUILD=true
    else
        FORCE_DOWNLOAD=true
    fi
    echo ""

    # Panel installation
    prompt_yesno "Install the panel (web UI)?" "y" WITH_PANEL

    # Installation paths
    echo ""
    echo "--- Installation paths ---"
    prompt "Installation prefix" "/usr/local" PREFIX
    prompt "Binary directory" "$PREFIX/bin" BINDIR

    if [[ "$WITH_PANEL" == "yes" ]]; then
        echo ""
        echo "--- Panel configuration ---"
        prompt "Panel listen host" "0.0.0.0" PANEL_HOST
        prompt "Panel listen port" "8080" PANEL_PORT
        echo ""

        # Admin credentials
        if [[ -z "$ADMIN_USERNAME" ]]; then
            prompt "Admin username" "admin" ADMIN_USERNAME
        fi
        if [[ -z "$ADMIN_PASSWORD" ]]; then
            # Generate a random password if not provided
            ADMIN_PASSWORD=$(tr -dc 'a-zA-Z0-9!@#$%^&*' < /dev/urandom 2>/dev/null | fold -w 20 | head -n1 || echo "tracer-admin-$(date +%s)")
            echo "Admin password: $ADMIN_PASSWORD"
        fi
    fi

    echo ""
    echo "--- Summary ---"
    echo "  Mode:         $([ "$FORCE_BUILD" == true ] && echo "Build from source" || echo "Download binaries")"
    echo "  Prefix:       $PREFIX"
    echo "  Bindir:       $BINDIR"
    echo "  Panel:        $WITH_PANEL"
    if [[ "$WITH_PANEL" == "yes" ]]; then
        echo "  Panel host:   $PANEL_HOST"
        echo "  Panel port:   $PANEL_PORT"
        echo "  Admin user:   $ADMIN_USERNAME"
    fi
    echo ""

    if ! prompt_yesno "Continue with installation?" "y" continue_install; then
        echo "Installation cancelled."
        exit 0
    fi
}

# ---- Obtain binaries (build or download) ----
obtain_binaries() {
    local work_dir
    work_dir=$(mktemp -d)
    trap 'rm -rf "$work_dir"' EXIT

    if [[ "$FORCE_DOWNLOAD" == "true" ]]; then
        if build_download "$work_dir"; then
            return 0
        fi
        log_warn "Download failed, falling back to build from source"
    fi

    # Try download if not forced, but only if URL is set
    if [[ "$FORCE_BUILD" != "true" && -n "$DOWNLOAD_URL" ]]; then
        if build_download "$work_dir"; then
            return 0
        fi
        log_warn "Download failed, falling back to build from source"
    fi

    # Build from source
    if is_source_available; then
        # We're in the source directory
        build_from_source "$(pwd)"
        return 0
    fi

    # Need to get source
    get_source "$work_dir"
    build_from_source "$work_dir/src"
}

is_source_available() {
    [[ -f Makefile && -d apps/panel && -d apps/collector ]]
}

get_source() {
    local dest="$1"
    local src_dir="$dest/src"
    mkdir -p "$src_dir"

    log_info "Downloading tracer source code..."

    # Try git clone first, fallback to snapshot tarball
    if command -v git &>/dev/null; then
        log_step "Cloning from repository..."
        if git clone --depth 1 https://git.naqerl.com/eco/tracer.git "$src_dir" 2>/dev/null; then
            return 0
        fi
        log_warn "Git clone failed, trying tarball..."
    fi

    # Fallback to snapshot
    local snapshot_url="https://git.naqerl.com/eco/tracer/snapshot/tracer-main.tar.gz"
    if curl -fsSL "$snapshot_url" 2>/dev/null | tar -xz -C "$dest" --strip-components=1 -C "$src_dir"; then
        return 0
    fi

    log_error "Failed to obtain source code"
    exit 1
}

# ---- Install services ----
install_services() {
    log_info "Installing tracer binaries..."

    if ! command -v "$BINDIR/tracer-collector" &>/dev/null; then
        log_error "tracer-collector binary not found in $BINDIR"
        exit 1
    fi

    # Install collector (creates user, group, dirs, config, systemd service)
    log_step "Running: tracer-collector install"
    if [[ -n "$COLLECTOR_API_KEY" ]]; then
        TRACER_COLLECTOR_API_KEY="$COLLECTOR_API_KEY" "$BINDIR/tracer-collector" install
    else
        "$BINDIR/tracer-collector" install
    fi

    if [[ "$WITH_PANEL" == "yes" ]]; then
        if ! command -v "$BINDIR/tracer-panel" &>/dev/null; then
            log_error "tracer-panel binary not found in $BINDIR"
            exit 1
        fi

        log_step "Running: tracer-panel install"
        if [[ -n "$PANEL_HOST" || -n "$PANEL_PORT" ]]; then
            [[ -n "$PANEL_HOST" ]] && export TRACER_PANEL_HOST="$PANEL_HOST"
            [[ -n "$PANEL_PORT" ]] && export TRACER_PANEL_PORT="$PANEL_PORT"
        fi
        "$BINDIR/tracer-panel" install

        # Initialize panel if needed
        log_step "Initializing panel..."
        local api_key
        api_key=$("$BINDIR/tracer-panel" -init -username "$ADMIN_USERNAME" -password "$ADMIN_PASSWORD" 2>/dev/null | grep '^collector_api_key=' | cut -d= -f2) || true

        if [[ -n "$api_key" ]]; then
            log_info "Configuring collector with API key..."
            if [[ -z "$COLLECTOR_API_KEY" ]]; then
                COLLECTOR_API_KEY="$api_key"
                "$BINDIR/tracer-collector" set api-key "$api_key"
            fi
        else
            log_info "Panel already initialized"
        fi
    fi
}

# ---- Start services ----
start_services() {
    log_info "Starting services..."

    if [[ "$WITH_SYSTEMD" == "auto" ]]; then
        if command -v systemctl &>/dev/null && [[ -f /etc/systemd/system/tracer-collector.service ]]; then
            WITH_SYSTEMD="yes"
        else
            log_warn "Systemd not detected, services must be started manually"
            return
        fi
    fi

    if [[ "$WITH_SYSTEMD" != "yes" ]]; then
        log_warn "Systemd disabled, services must be started manually"
        return
    fi

    log_step "Starting tracer-collector..."
    systemctl daemon-reload 2>/dev/null || true
    systemctl enable --now tracer-collector 2>/dev/null || log_warn "Failed to enable/start tracer-collector"

    if [[ "$WITH_PANEL" == "yes" ]]; then
        log_step "Starting tracer-panel..."
        systemctl enable --now tracer-panel 2>/dev/null || log_warn "Failed to enable/start tracer-panel"

        # Add self-monitoring
        sleep 1
        "$BINDIR/tracer-collector" add --health "http://localhost:${PANEL_PORT}/auth/login" tracer-panel.service 2>/dev/null || true
    fi

    "$BINDIR/tracer-collector" add tracer-collector.service 2>/dev/null || true
}

# ---- Print installation summary ----
print_install_summary() {
    echo ""
    echo "=============================================="
    log_info "Installation complete!"
    echo "=============================================="
    echo ""

    echo "  Binaries installed in: $BINDIR"
    echo "  Configuration:          /etc/tracer/"
    echo "  Data:                   /var/lib/tracer/"
    echo ""

    if [[ "$WITH_SYSTEMD" == "yes" ]]; then
        echo "  Services:"
        echo "    tracer-collector:    active (enabled)"
        if [[ "$WITH_PANEL" == "yes" ]]; then
            echo "    tracer-panel:        active (enabled)"
        fi
        echo ""
        echo "  Status:"
        echo "    systemctl status tracer-collector"
        [[ "$WITH_PANEL" == "yes" ]] && echo "    systemctl status tracer-panel"
    else
        echo "  Start services manually:"
        echo "    sudo $BINDIR/tracer-collector &"
        [[ "$WITH_PANEL" == "yes" ]] && echo "    sudo $BINDIR/tracer-panel &"
    fi

    if [[ "$WITH_PANEL" == "yes" ]]; then
        echo ""
        echo "  Panel URL:"
        echo "    http://localhost:${PANEL_PORT}/"
        if [[ -n "$ADMIN_USERNAME" && -n "$ADMIN_PASSWORD" ]]; then
            echo ""
            echo "  Admin credentials:"
            echo "    Username: $ADMIN_USERNAME"
            echo "    Password: $ADMIN_PASSWORD"
            echo ""
            log_warn "Save your admin password! It will not be shown again."
        fi
    fi
    echo ""
}

# ---- Main ----
main() {
    # Handle --make-config mode (development only, no installation)
    if [[ "$MODE" == "make-config" ]]; then
        generate_make_config
        exit 0
    fi

    # If we're in a source tree and no args given, ask what to do
    if [[ $# -eq 0 && -f Makefile && -d apps ]]; then
        echo "You are in the tracer source directory."
        echo ""
        echo "What would you like to do?"
        echo "  1) Generate build/config.mk and exit (development mode)"
        echo "  2) Interactive installation wizard"
        echo "  3) Exit"
        echo ""
        read -r -p "Select [1/2/3] (default: 1): " mode_choice
        mode_choice="${mode_choice:-1}"
        case "$mode_choice" in
            1) generate_make_config; exit 0 ;;
            2) ;;  # continue to interactive setup
            *) exit 0 ;;
        esac
    fi

    # Interactive mode if no flags set
    if [[ "$FORCE_BUILD" != "true" && "$FORCE_DOWNLOAD" != "true" && -z "$ADMIN_USERNAME" && -z "$COLLECTOR_API_KEY" ]]; then
        interactive_setup
    fi

    # Check root for installation
    check_root

    # Obtain binaries (build or download)
    echo ""
    echo "=========================================="
    echo "   Obtaining binaries"
    echo "=========================================="
    echo ""
    obtain_binaries

    # Install services
    echo ""
    echo "=========================================="
    echo "   Installing system services"
    echo "=========================================="
    echo ""
    install_services

    # Start services
    echo ""
    echo "=========================================="
    echo "   Starting services"
    echo "=========================================="
    echo ""
    start_services

    # Print summary
    print_install_summary
}

parse_args "$@"
main
